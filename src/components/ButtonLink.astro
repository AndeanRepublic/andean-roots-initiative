---
import UpRightArrowIcon from '../icons/UpRightArrowIcon.astro';

type ButtonDevice = 'desktop' | 'mobile';
type ButtonKind = 'primary' | 'primary-inverse' | 'secondary';

interface Props {
  href?: string;
  text?: string;
  device?: ButtonDevice;
  kind?: ButtonKind;
  class?: string;
  bordered?: boolean;
}

const {
  href = '#',
  text = 'GET INVOLVED',
  device = 'desktop',
  kind = 'primary',
  class: className = '',
  bordered = false,
  ...anchorAttrs
} = Astro.props as Props & Record<string, unknown>;

const isPrimary = kind === 'primary';
const isInverse = kind === 'primary-inverse';
const isMobile = device === 'mobile';

/** Outer: scroll/intro tweens pueden animar transform en el <a>; el magnético vive en el span interno. */
const outerClass = 'button-link-root group inline-flex shrink-0 items-center transition-opacity ';
const innerClass = 'button-link will-change-[transform] inline-flex shrink-0 items-center';
// Border color matches the text color of each variant: primary→white, inverse/secondary→main
const borderClass = bordered ? 'border border-white' : '';

const variantClass = isInverse
  ? `rounded-full bg-white text-main gap-md pl-lg pr-xs py-xs tablet:gap-lg tablet:pl-xl tablet:pr-sm tablet:py-sm ${borderClass}`
  : isPrimary
    ? `rounded-full bg-main text-white gap-md pl-lg pr-[3px] tablet:pr-[6px] py-[3px] tablet:py-[6px] ${borderClass}`
    : `text-main gap-sm ${borderClass}`;
const textClass = isMobile ? 'text-[14px] font-semibold leading-[1.5]' : 'body-md-sb';
const iconWrapperClass = isPrimary
  ? isMobile
    ? 'flex items-center justify-center rounded-full bg-light p-xs'
    : 'flex items-center justify-center rounded-full bg-light p-sm'
  : isInverse
    ? isMobile
      ? 'flex items-center justify-center rounded-full bg-main p-xs'
      : 'flex items-center justify-center rounded-full bg-main p-sm'
    : 'flex items-center justify-center';
const iconClass = isPrimary
  ? isMobile
    ? 'size-4 text-main'
    : 'size-4 text-main'
  : isInverse
    ? isMobile
      ? 'size-4 text-light'
      : 'size-5 text-light'
    : 'size-4 text-main';
---

<a {...anchorAttrs} href={href} class={`${outerClass} ${className}`.trim()} data-button-link-root>
  <span class={`${innerClass} ${variantClass}`.trim()} data-button-link>
    <span class={textClass}>{text}</span>
    <span class={iconWrapperClass}>
      <UpRightArrowIcon class={iconClass} />
    </span>
  </span>
</a>
