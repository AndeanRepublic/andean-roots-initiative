---
import ButtonLink from '../ButtonLink/index.astro';
import DonationModal from '../DonationModal/index';
import type { Locale } from '../../i18n/locales';
import { DEFAULT_LOCALE } from '../../i18n/locales';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const c = t.cta;
---

<section id="impacto" class="px-2xl desktop:py-6xl bg-white py-12">
  <div class="mx-auto w-full max-w-328">
    <div
      class="bg-main tablet:min-h-112 tablet:px-10 tablet:py-16 desktop:min-h-125 desktop:px-8xl desktop:py-6xl relative flex min-h-88 flex-col items-center justify-center overflow-hidden rounded-lg px-6 py-12"
    >
      <img
        src="/home-assets/Numbers/vector.png"
        alt=""
        class="pointer-events-none absolute inset-0 size-full object-cover opacity-25"
        loading="lazy"
        aria-hidden="true"
      />

      <div
        class="tablet:gap-10 desktop:gap-20 relative z-10 flex w-full max-w-150 flex-col items-center gap-8 text-center"
      >
        <h2
          class="font-skrawk-serif tablet:text-[3rem] desktop:text-[3.5rem] desktop:leading-[0.8] text-[2rem] leading-[0.8] text-white"
        >
          {c.title}
        </h2>
        <p class="body-md-l text-light max-w-150">
          {c.description}
        </p>
        <div class="tablet:gap-6 hidden w-full flex-row items-center justify-center gap-4 desktop:flex">
          <span data-donation-trigger>
            <ButtonLink
              class="inline-flex"
              href="#"
              text={c.donateText}
              device="desktop"
              kind="primary-inverse"
              bordered
            />
          </span>
          <ButtonLink
            class="inline-flex"
            href={getLocalizedPath(lang, c.ctaSlug)}
            text={c.ctaText}
            device="desktop"
            kind="primary"
            bordered
          />
        </div>
        <div class="tablet:gap-6 flex w-full flex-row items-center justify-center gap-4 desktop:hidden">
          <span data-donation-trigger>
            <ButtonLink
              class="inline-flex"
              href="#"
              text={c.donateText}
              device="mobile"
              kind="primary-inverse"
              bordered
            />
          </span>
          <ButtonLink
            class="inline-flex"
            href={getLocalizedPath(lang, c.ctaSlug)}
            text={c.ctaText}
            device="mobile"
            kind="primary"
            bordered
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Island: invisible hasta que se abre, escucha el CustomEvent del boton -->
  <DonationModal client:load />

  <script>
    function initDonationTrigger() {
      document.querySelectorAll('[data-donation-trigger]').forEach((trigger) => {
        if (trigger instanceof HTMLElement && trigger.dataset.donationBound === '1') return;
        trigger.addEventListener('click', (e) => {
          e.preventDefault();
          document.dispatchEvent(new CustomEvent('open-donation-modal'));
        });
        if (trigger instanceof HTMLElement) trigger.dataset.donationBound = '1';
      });
    }

    initDonationTrigger();
    document.addEventListener('astro:page-load', initDonationTrigger);
  </script>
</section>
