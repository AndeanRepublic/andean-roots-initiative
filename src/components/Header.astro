---
import HamburgerIcon from '../icons/HamburgerIcon.astro';
import type { Locale } from '../i18n/locales';
import { DEFAULT_LOCALE } from '../i18n/locales';
import { useTranslations, getAlternateUrl, getLocalizedPath } from '../i18n/utils';
import { cn } from '../cn';

interface Props {
  /** Oculto hasta el final del intro del Home (GSAP). */
  heroEntrance?: boolean;
  lang?: Locale;
}

const { heroEntrance = false, lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);

const pathname = Astro.url.pathname;

const navLinks = t.header.navLinks.map((link) => ({
  label: link.label,
  href: getLocalizedPath(lang, link.slug),
  slug: link.slug,
}));

const normalizePathPart = (href: string) => {
  const [pathPart] = href.split('#');
  if (!pathPart || pathPart === '#') return '';
  return pathPart.length > 1 && pathPart.endsWith('/') ? pathPart.slice(0, -1) : pathPart;
};

const normalizedPath =
  pathname.length > 1 && pathname.endsWith('/') ? pathname.slice(0, -1) : pathname;
const matchingLinks = navLinks.filter((link) => normalizePathPart(link.href) === normalizedPath);
const activeHref =
  matchingLinks.find((link) => !link.href.includes('#'))?.href ?? matchingLinks[0]?.href;
const isActiveHref = (href: string) => href === activeHref;

const alternateLang: Locale = lang === 'es' ? 'en' : 'es';
const alternateUrl = getAlternateUrl(pathname, alternateLang);
---

<header
  data-hero-header={heroEntrance ? true : undefined}
  class={cn(
    'fixed top-0 left-0 right-0 z-50 px-2xl pt-3xl max-md:px-4 max-md:pt-4',
    heroEntrance && 'opacity-0 -translate-y-4',
  )}
>
  <nav
    class="px-2xl py-lg mx-auto flex w-full max-w-[1312px] items-center justify-between rounded-full bg-black/20 backdrop-blur-md max-md:gap-4 max-md:px-4 max-md:py-3"
  >
    <a
      href={getLocalizedPath(lang, 'Home')}
      class="px-lg flex items-center max-md:px-0"
      aria-label={t.header.brandAriaLabel}
    >
      <img
        src="/home-assets/logo.png"
        alt="Andean Roots Initiative"
        class="h-10 w-auto"
        width="68"
        height="40"
      />
    </a>

    <!-- Desktop nav -->
    <ul class="gap-sm relative flex items-center max-md:hidden" role="menubar" data-nav-list>
      <li
        class="pointer-events-none absolute top-0 left-0 z-0 rounded-full bg-white opacity-0 transition-[transform,width,height,opacity] duration-300 ease-out"
        data-nav-indicator
        role="none"
        aria-hidden="true"
      >
      </li>
      {
        navLinks.map((link) => (
          <li role="none" class="relative z-10">
            <a
              href={link.href}
              class={`body-md-sb px-xl py-sm rounded-full text-white transition-colors ${
                isActiveHref(link.href) ? 'text-main' : ''
              }`}
              data-nav-link
              role="menuitem"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-3 max-md:gap-2">
      <!-- Language switcher (desktop) -->
      <a
        href={alternateUrl}
        class="body-md-sb flex items-center gap-1 rounded-full border border-white/40 bg-white/10 px-3 py-1.5 text-sm text-white transition-colors hover:bg-white/20 max-md:hidden"
        aria-label={lang === 'es' ? 'Switch to English' : 'Cambiar a Español'}
      >
        {lang === 'es' ? 'EN' : 'ES'}
      </a>

      <!-- Mobile hamburger -->
      <details class="relative hidden max-md:block">
        <summary
          aria-label={t.header.mobileMenuAriaLabel}
          class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full border border-white/40 bg-white/10 [&::-webkit-details-marker]:hidden"
        >
          <HamburgerIcon class="size-6 text-white" />
        </summary>
        <ul
          class="absolute top-[calc(100%+0.5rem)] right-0 flex min-w-[220px] flex-col gap-2 rounded-2xl border border-white/20 bg-black/55 p-3 backdrop-blur-md"
          role="menu"
        >
          {
            navLinks.map((link) => (
              <li role="none">
                <a
                  href={link.href}
                  class={`px-lg py-sm block rounded-full text-center transition-colors ${
                    isActiveHref(link.href)
                      ? 'text-main body-md-sb bg-white'
                      : 'body-md-sb text-white hover:bg-white/10'
                  }`}
                  data-mobile-nav-link
                  role="menuitem"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li role="none" class="mt-1 border-t border-white/20 pt-1">
            <a
              href={alternateUrl}
              class="px-lg py-sm body-md-sb block rounded-full text-center text-white/70 transition-colors hover:bg-white/10"
              role="menuitem"
            >
              {lang === 'es' ? '🌐 English' : '🌐 Español'}
            </a>
          </li>
        </ul>
      </details>
    </div>
  </nav>
</header>

<script>
  // ── Helpers ──────────────────────────────────────────────────────────────────

  const getNormalizedPath = (path: string) =>
    path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path;

  const normalizePathFromHref = (href: string) => {
    const [pathPart] = href.split('#');
    if (!pathPart || pathPart === '#') return '';
    return getNormalizedPath(pathPart);
  };

  // ── Nav indicator (pill that slides under active link) ────────────────────

  const getActiveLinkFromLocation = (links: HTMLAnchorElement[]) => {
    const currentPath = getNormalizedPath(window.location.pathname);
    const matching = links.filter(
      (link) => normalizePathFromHref(link.getAttribute('href') ?? '') === currentPath,
    );
    return (
      matching.find((link) => !(link.getAttribute('href') ?? '').includes('#')) ??
      matching[0] ??
      links[0] ??
      null
    );
  };

  const initDesktopNavIndicator = () => {
    const navLists = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-list]'));
    const cleanups: Array<() => void> = [];

    navLists.forEach((list) => {
      const indicator = list.querySelector<HTMLElement>('[data-nav-indicator]');
      const links = Array.from(list.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
      if (!indicator || links.length === 0) return;

      const placeIndicator = (target: HTMLAnchorElement | null, instant = false) => {
        if (!target) {
          indicator.style.opacity = '0';
          links.forEach((link) => {
            link.classList.remove('text-main');
            link.classList.add('text-white');
          });
          return;
        }

        const listRect = list.getBoundingClientRect();
        const targetRect = target.getBoundingClientRect();
        const x = targetRect.left - listRect.left;
        const y = targetRect.top - listRect.top;

        if (instant) indicator.style.transitionDuration = '0ms';
        indicator.style.transform = `translate(${x}px, ${y}px)`;
        indicator.style.width = `${targetRect.width}px`;
        indicator.style.height = `${targetRect.height}px`;
        indicator.style.opacity = '1';
        links.forEach((link) => {
          const isCurrent = link === target;
          link.classList.toggle('text-main', isCurrent);
          link.classList.toggle('text-white', !isCurrent);
        });
        if (instant) requestAnimationFrame(() => (indicator.style.transitionDuration = '300ms'));
      };

      const getActiveLink = () => getActiveLinkFromLocation(links);

      placeIndicator(getActiveLink(), true);

      const ac = new AbortController();
      const { signal } = ac;

      links.forEach((link) => {
        link.addEventListener('mouseenter', () => placeIndicator(link), { signal });
        link.addEventListener('focus', () => placeIndicator(link), { signal });
      });

      list.addEventListener('mouseleave', () => placeIndicator(getActiveLink()), { signal });
      list.addEventListener(
        'focusout',
        (event) => {
          const nextTarget = event.relatedTarget;
          if (!(nextTarget instanceof Node) || !list.contains(nextTarget)) {
            placeIndicator(getActiveLink());
          }
        },
        { signal },
      );

      window.addEventListener('resize', () => placeIndicator(getActiveLink(), true), { signal });

      cleanups.push(() => ac.abort());
    });

    return () => cleanups.forEach((cleanup) => cleanup());
  };

  let cleanupDesktopNavIndicator: (() => void) | undefined;

  const boot = () => {
    cleanupDesktopNavIndicator?.();
    cleanupDesktopNavIndicator = initDesktopNavIndicator();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }

  document.addEventListener('astro:page-load', boot);
</script>
