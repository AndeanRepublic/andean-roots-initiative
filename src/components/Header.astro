---
import HamburgerIcon from '../icons/HamburgerIcon.astro';
import { headerContent } from '../data/home-content';
import { cn } from '../cn';

interface Props {
  /** When true, header starts hidden for the Home Hero GSAP intro (see Hero.astro). */
  heroEntrance?: boolean;
}

const { heroEntrance = false } = Astro.props;

const pathname = Astro.url.pathname;
const normalizedPath = pathname.length > 1 && pathname.endsWith('/') ? pathname.slice(0, -1) : pathname;

const isActiveHref = (href: string) => {
  const [pathPart] = href.split('#');
  if (!pathPart || pathPart === '#') return false;
  const normalizedHref = pathPart.length > 1 && pathPart.endsWith('/') ? pathPart.slice(0, -1) : pathPart;
  return normalizedHref === normalizedPath;
};
---

<header
  data-hero-header={heroEntrance ? true : undefined}
  class={cn(
    'fixed top-0 left-0 right-0 z-50 px-2xl pt-3xl max-md:px-4 max-md:pt-4 ',
    heroEntrance && 'opacity-0 -translate-y-4',
  )}
>
  <nav
    class="px-2xl py-lg mx-auto flex w-full max-w-[1312px] items-center justify-between rounded-full bg-black/20 backdrop-blur-md max-md:gap-4 max-md:px-4 max-md:py-3"
  >
    <a
      href="/"
      class="px-lg flex items-center max-md:px-0"
      aria-label={headerContent.brandAriaLabel}
    >
      <img
        src="/home-assets/logo.png"
        alt="Andean Roots Initiative"
        class="h-10 w-auto"
        width="68"
        height="40"
      />
    </a>

    <ul class="gap-sm flex items-center max-md:hidden" role="menubar">
      {
        headerContent.navLinks.map((link) => (
          <li role="none">
            <a
              href={link.href}
              class={`px-xl py-sm rounded-full transition-colors ${
                isActiveHref(link.href)
                  ? 'text-main body-md-sb bg-white'
                  : 'body-md-l text-white hover:opacity-90'
              }`}
              role="menuitem"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <details class="relative hidden max-md:block">
      <summary
        aria-label={headerContent.mobileMenuAriaLabel}
        class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full border border-white/40 bg-white/10 [&::-webkit-details-marker]:hidden"
      >
        <HamburgerIcon class="size-6 text-white" />
      </summary>
      <ul
        class="absolute top-[calc(100%+0.5rem)] right-0 flex min-w-[220px] flex-col gap-2 rounded-2xl border border-white/20 bg-black/55 p-3 backdrop-blur-md"
        role="menu"
      >
        {
          headerContent.navLinks.map((link) => (
            <li role="none">
              <a
                href={link.href}
                class={`px-lg py-sm block rounded-full text-center transition-colors ${
                  isActiveHref(link.href)
                    ? 'text-main body-md-sb bg-white'
                    : 'body-md-l text-white hover:bg-white/10'
                }`}
                role="menuitem"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </nav>
</header>
