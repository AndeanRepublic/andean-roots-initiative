---
import HamburgerIcon from '../icons/HamburgerIcon.astro';

const navLinks = [
  { label: 'Home', href: '#', active: true },
  { label: 'Sobre nosotros', href: '#about' },
  { label: 'Programas', href: '#actions' },
  { label: 'Contacto', href: '#contact' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 px-6xl pt-3xl max-md:px-4 max-md:pt-4">
  <nav class="mx-auto flex w-full max-w-[1312px] items-center justify-between rounded-full bg-black/20 px-2xl py-lg backdrop-blur-md max-md:gap-4 max-md:px-4 max-md:py-3">
    <a href="/" class="flex items-center px-lg max-md:px-0" aria-label="Andean Roots Initiative - Inicio">
      <img src="/home-assets/logo.png" alt="Andean Roots Initiative" class="h-10 w-auto" width="68" height="40" />
    </a>

    <ul class="flex items-center gap-sm max-md:hidden" role="menubar">
      {navLinks.map((link) => (
        <li role="none">
          <a
            href={link.href}
            class={`rounded-full px-xl py-sm transition-colors ${
              link.active
                ? 'bg-white text-main body-md-sb'
                : 'text-white body-md-l hover:opacity-90'
            }`}
            role="menuitem"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <details class="relative hidden max-md:block">
      <summary
        aria-label="Abrir navegación"
        class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full border border-white/40 bg-white/10 [&::-webkit-details-marker]:hidden"
      >
        <HamburgerIcon class="size-6 text-white" />
      </summary>
      <ul class="absolute right-0 top-[calc(100%+0.5rem)] flex min-w-[220px] flex-col gap-2 rounded-2xl border border-white/20 bg-black/55 p-3 backdrop-blur-md" role="menu">
        {navLinks.map((link) => (
          <li role="none">
            <a
              href={link.href}
              class={`block rounded-full px-lg py-sm text-center transition-colors ${
                link.active
                  ? 'bg-white text-main body-md-sb'
                  : 'text-white body-md-l hover:bg-white/10'
              }`}
              role="menuitem"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </nav>
</header>
