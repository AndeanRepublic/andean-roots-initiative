---
import { cn } from '../../cn';
import type { Locale } from '../../i18n/locales';
import { useTranslations } from '../../i18n/utils';

interface Props {
  navLinks: Array<{ label: string; href: string; slug: string }>;
  alternateUrl: string;
  lang: Locale;
  activeHref: string | undefined;
}

const { navLinks, alternateUrl, lang, activeHref } = Astro.props;
const tEs = useTranslations('es');
const tEn = useTranslations('en');
const hrefForSlug = (slug: string) => navLinks.find((link) => link.slug === slug)?.href ?? '#';
/* Closed overlay clip — must match mobile-menu-animation.ts CLIP_CLOSED */
const overlayClipClosed = '[clip-path:polygon(0%_0%,100%_0%,100%_0%,0%_0%)]';

const secondaryLinks = [
  { label: lang === 'es' ? 'Nuestra historia' : 'Our story', href: hrefForSlug('About') },
  {
    label: lang === 'es' ? 'Programas de impacto' : 'Impact programs',
    href: hrefForSlug('programs'),
  },
  { label: lang === 'es' ? 'Escríbenos' : 'Write to us', href: hrefForSlug('contact') },
];
---

<div
  transition:persist="mobile-menu-root"
  data-mobile-menu-root
  class="pointer-events-none fixed inset-0 z-40 hidden overflow-hidden text-white max-tb:block"
>
  <div
    data-mobile-menu-overlay
    aria-hidden="true"
    class:list={[
      'bg-main absolute inset-0 overflow-hidden will-change-[clip-path]',
      overlayClipClosed,
    ]}
  >
    <div
      data-mobile-menu-content
      class="px-2xl absolute inset-0 flex translate-y-[-50%] flex-col justify-between pt-28 pb-9 will-change-transform"
    >
      <div class="px-2xl flex min-h-0 flex-1 items-center">
        <div class="w-full">
          <div class="px-lg flex flex-col gap-12">
            <div data-mobile-menu-col class="flex flex-col gap-1">
              {
                navLinks.map((link) => (
                  <div class="overflow-hidden py-1.5">
                    <a
                      href={link.href}
                      data-nav-link
                      data-nav-slug={link.slug}
                      data-nav-label-es={
                        tEs.header.navLinks.find((item) => item.slug === link.slug)?.label ??
                        link.label
                      }
                      data-nav-label-en={
                        tEn.header.navLinks.find((item) => item.slug === link.slug)?.label ??
                        link.label
                      }
                      data-mobile-menu-line
                      class={cn(
                        'font-nunito-sans block translate-y-[-110%] text-[2.8rem] leading-none font-semibold tracking-tight',
                        'will-change-transform',
                        link.href === activeHref ? 'text-white' : 'text-white/40',
                      )}
                    >
                      {link.label}
                    </a>
                  </div>
                ))
              }
            </div>

            <!-- <div data-mobile-menu-col class="flex flex-col gap-2">
              {
                secondaryLinks.map((link) => (
                  <div class="overflow-hidden">
                    <a
                      href={link.href}
                      data-mobile-menu-line
                      class="block text-base font-medium text-white/45 transition-colors will-change-transform hover:text-white/80"
                    >
                      {link.label}
                    </a>
                  </div>
                ))
              }
            </div> -->
          </div>
        </div>
      </div>

      <div
        data-mobile-menu-footer
        class="px-4xl grid grid-cols-[1fr_auto] items-end gap-6 border-t border-white/10 pt-5 text-sm font-medium text-white/40 will-change-transform"
      >
        <div data-mobile-menu-col class="flex flex-col gap-1 overflow-hidden">
          <p data-mobile-menu-line class="translate-y-[-110%] will-change-transform">
            Andean Roots Initiative
          </p>
          <p data-mobile-menu-line class="translate-y-[-110%] will-change-transform">
            {lang === 'es' ? 'Raíces andinas, futuro global' : 'Andean roots, global future'}
          </p>
        </div>

        <div class="overflow-hidden">
          <a
            href={alternateUrl}
            data-lang-switch
            data-mobile-menu-line
            class="block translate-y-[-110%] rounded-full border border-white/60 px-4 py-2 text-[1.2rem] text-white transition-colors will-change-transform hover:border-white/40 hover:text-white"
          >
            <span data-lang-switch-label>{lang === 'es' ? 'EN' : 'ES'}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* First-paint "menu still open" after in-app nav (see Layout head script). */
  html.mobile-menu--pending-close [data-mobile-menu-root] {
    pointer-events: auto;
  }
  html.mobile-menu--pending-close [data-mobile-menu-overlay] {
    clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%);
  }
  html.mobile-menu--pending-close [data-mobile-menu-content] {
    transform: translate3d(0, 0, 0);
  }
  html.mobile-menu--pending-close [data-mobile-menu-line] {
    transform: translate3d(0, 0, 0);
  }
</style>

<script>
  import { initMobileMenuAnimation } from './mobile-menu-animation';

  const boot = () => initMobileMenuAnimation();

  document.addEventListener('astro:page-load', boot);
</script>
