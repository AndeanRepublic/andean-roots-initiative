---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import type { Locale } from '../i18n/locales';
import { DEFAULT_LOCALE } from '../i18n/locales';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: Locale;
}

const {
  title = 'Andean Roots Initiative',
  description = 'Astro + TypeScript + Tailwind + GSAP',
  lang = DEFAULT_LOCALE,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredericka+the+Great&family=Manrope:wght@300;500;600;700&family=Montserrat:wght@800;900&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <Font cssVariable="--font-skrawk-serif" preload />
    <!--
      Mobile menu: mark pending close before first paint so the overlay keeps
      clip-path "open" until GSAP runs (avoids full bg-main flash on swap).
    -->
    <script is:inline>
      (function () {
        try {
          if (sessionStorage.getItem('mobile-menu-close-after-nav') === '1') {
            document.documentElement.classList.add('mobile-menu--pending-close');
          }
        } catch {
          /* no sessionStorage */
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="font-manrope min-h-screen overflow-x-hidden bg-white text-black antialiased">
    <slot />
    <script>
      import { initButtonLinkMagnetic } from '../components/ButtonLink/animation';
      import { registerHomeHeroNavContext } from '../utils/home-hero-nav-context';

      registerHomeHeroNavContext();
      document.addEventListener('astro:page-load', initButtonLinkMagnetic);
    </script>
  </body>
</html>
