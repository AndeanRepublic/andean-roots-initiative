---
import GroupIcon from '../../../icons/Group.astro';
import BulbIcon from '../../../icons/Bulb.astro';
import HandshakeIcon from '../../../icons/HandshakeIcon.astro';
import SustainabilityIcon from '../../../icons/SustainabilityIcon.astro';
import { aboutFocusContent } from '../../../data/about-content';
---

<section class="bg-white px-4 py-12 tablet:px-6 desktop:px-6xl desktop:py-6xl">
  <div class="mx-auto flex w-full max-w-328 flex-col gap-8 desktop:gap-8">
    <div class="grid items-end gap-6 desktop:grid-cols-[19.0625rem_1fr_19rem] desktop:gap-px">
      <div class="overflow-hidden rounded-[1.25rem]">
        <img
          src={aboutFocusContent.sideImages[0].src}
          alt={aboutFocusContent.sideImages[0].alt}
          class="h-50 w-full object-cover"
          loading="lazy"
        />
      </div>

      <div class="flex flex-col items-center gap-8 px-4">
        <div class="flex items-center gap-sm">
          <span class="size-2 rounded-full bg-main" aria-hidden="true"></span>
          <p class="body-md-sb text-main">{aboutFocusContent.label}</p>
        </div>
        <h2 class="auxiliar-h-lg-skrawk-r text-center text-main">{aboutFocusContent.title}</h2>
        <p class="max-w-140 body-md-l text-center text-gray">{aboutFocusContent.description}</p>
      </div>

      <div class="overflow-hidden rounded-lg">
        <img
          src={aboutFocusContent.sideImages[1].src}
          alt={aboutFocusContent.sideImages[1].alt}
          class="h-50 w-full object-cover"
          loading="lazy"
        />
      </div>
    </div>

    <div class="grid gap-6 desktop:grid-cols-4 desktop:gap-8">
      {
        aboutFocusContent.cards.map((card) => (
          <article
            class={`flex min-h-81 flex-col justify-between gap-6 rounded-lg bg-light p-8 ${card.offsetClass ?? ''}`}
          >
            <span class="flex size-12 items-center justify-center rounded-full bg-main">
              {card.icon === 'group' && <GroupIcon class="h-5 w-8" />}
              {card.icon === 'bulb' && <BulbIcon class="h-8 w-6.5" />}
              {card.icon === 'handshake' && <HandshakeIcon class="h-5 w-8 invert brightness-0 saturate-0" />}
              {card.icon === 'sustainability' && <SustainabilityIcon class="h-8 w-6.5" />}
            </span>

            <div class="flex flex-col gap-4">
              <h3 class="heading-sm-sb text-black">{card.title}</h3>
              <p class="body-md-l text-gray">{card.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
