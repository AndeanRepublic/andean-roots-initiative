---
import { aboutHeroContent } from '../../../data/about-content';
---

<section class="relative h-148.5 overflow-hidden bg-black">
  <div class="absolute inset-0" aria-hidden="true">
    <img
      src={aboutHeroContent.backgroundImageSrc}
      alt={aboutHeroContent.backgroundImageAlt}
      class="size-full object-cover object-center"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-black/60"></div>
  </div>

  <div
    class="relative mx-auto flex h-full w-full max-w-328 flex-col items-end justify-end px-4 pb-10 tablet:px-6 tablet:pb-12 desktop:px-0 desktop:pb-19.5"
  >
    <h1 class="heading-xl-sb text-right text-white">{aboutHeroContent.title}</h1>

    <nav
      aria-label={aboutHeroContent.breadcrumbAriaLabel}
      class="mt-2 flex items-center gap-3.5 text-white"
    >
      {
        aboutHeroContent.breadcrumb.map((item, index) => (
          <>
            {index > 0 && <span class="size-1.25 rounded-full bg-white/80" aria-hidden="true" />}
            {item.current ? (
              <span class="heading-sm-sb text-white">{item.label}</span>
            ) : (
              <a
                href={item.href}
                class="heading-sm-sb text-white transition-opacity hover:opacity-80"
              >
                {item.label}
              </a>
            )}
          </>
        ))
      }
    </nav>
  </div>
</section>
