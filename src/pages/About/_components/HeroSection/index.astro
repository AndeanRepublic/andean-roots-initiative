---
import SiteHero from '../../../../components/SiteHero/SiteHero.astro';
import { aboutHeroContent } from '../../../../data/about-content';
---

<SiteHero
  rootId="about-hero"
  title={aboutHeroContent.title}
  backgroundImageSrc={aboutHeroContent.backgroundImageSrc}
  backgroundImageAlt={aboutHeroContent.backgroundImageAlt}
  backgroundImageClass="[transform-origin:center]"
  breadcrumbAriaLabel={aboutHeroContent.breadcrumbAriaLabel}
  breadcrumb={aboutHeroContent.breadcrumb}
/>
