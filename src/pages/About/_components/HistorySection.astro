---
import { aboutHistoryContent } from '../../../data/about-content';
---

<section class="bg-white px-4 py-12 tablet:px-6 desktop:px-6xl desktop:py-6xl">
  <div class="mx-auto flex w-full max-w-328 flex-col gap-8 desktop:gap-16">
    <h2 class="auxiliar-h-lg-skrawk-r text-center text-main">{aboutHistoryContent.title}</h2>

    <div class="grid gap-8 desktop:grid-cols-3 desktop:gap-8">
      {
        aboutHistoryContent.cards.map((card) => (
          <article class={`flex flex-col gap-6 ${card.offsetClass ?? ''}`}>
            <div class="overflow-hidden rounded-lg">
              <img
                src={card.imageSrc}
                alt={card.imageAlt}
                class="h-76.5 w-full object-cover desktop:h-auto desktop:min-h-76.5"
                loading="lazy"
              />
            </div>

            <div class="flex flex-col gap-3 text-gray">
              {card.paragraphs.map((paragraph) => (
                <p class="body-md-l">{paragraph}</p>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
