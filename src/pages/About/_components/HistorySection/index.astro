---
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const h = t.aboutPage.history;
---

<section id="about-history" class="px-2xl dk:py-6xl bg-white py-12">
  <div class="dk:gap-16 mx-auto flex w-full max-w-328 flex-col gap-8">
    <h2
      class="auxiliar-h-lg-skrawk-r text-main text-center"
      data-anim="title"
      data-history-text-line
    >
      {h.title}
    </h2>

    <div class="dk:grid-cols-3 dk:gap-8 grid gap-8" data-anim="cards">
      {
        h.cards.map((card) => (
          <article class={`flex flex-col gap-6 ${card.offsetClass ?? ''}`} data-anim="card">
            <div class="overflow-hidden rounded-lg" data-anim="card-media">
              <img
                src={card.imageSrc}
                alt={card.imageAlt}
                class="dk:h-auto dk:min-h-76.5 h-76.5 w-full object-cover"
                loading="lazy"
                data-anim="card-image"
              />
            </div>

            <div class="text-gray flex flex-col gap-3" data-anim="card-body">
              {card.paragraphs.map((paragraph) => (
                <p class="body-md-l" data-history-text-words>
                  {paragraph}
                </p>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { initHistorySectionAnimation } from './animation';

  const init = () => initHistorySectionAnimation();

  document.addEventListener('astro:page-load', init);
</script>
