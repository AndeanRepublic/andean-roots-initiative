---
import { aboutHistoryContent } from '../../../../data/about-content';
---

<section id="about-history" class="bg-white px-4 py-12 tablet:px-6 desktop:px-6xl desktop:py-6xl">
  <div class="mx-auto flex w-full max-w-328 flex-col gap-8 desktop:gap-16">
    <h2 class="auxiliar-h-lg-skrawk-r text-center text-main" data-anim="title" data-history-text-line>
      {aboutHistoryContent.title}
    </h2>

    <div class="grid gap-8 desktop:grid-cols-3 desktop:gap-8" data-anim="cards">
      {
        aboutHistoryContent.cards.map((card) => (
          <article class={`flex flex-col gap-6 ${card.offsetClass ?? ''}`} data-anim="card">
            <div class="overflow-hidden rounded-lg" data-anim="card-media">
              <img
                src={card.imageSrc}
                alt={card.imageAlt}
                class="h-76.5 w-full object-cover desktop:h-auto desktop:min-h-76.5"
                loading="lazy"
                data-anim="card-image"
              />
            </div>

            <div class="flex flex-col gap-3 text-gray" data-anim="card-body">
              {card.paragraphs.map((paragraph) => (
                <p class="body-md-l" data-history-text-words>{paragraph}</p>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { initHistorySectionAnimation } from './animation';

  const init = () => initHistorySectionAnimation();
  document.addEventListener('DOMContentLoaded', init, { once: true });
  document.addEventListener('astro:page-load', init);
</script>
