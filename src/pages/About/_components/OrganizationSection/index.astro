---
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const o = t.aboutPage.organization;
---

<section
  id="about-organization"
  class="tablet:px-6 desktop:px-6xl desktop:py-6xl bg-white px-4 py-12"
>
  <div class="desktop:gap-16 mx-auto flex w-full max-w-328 flex-col gap-8">
    <div class="flex flex-col gap-4" data-anim="header">
      <div class="gap-sm flex items-center" data-anim="label">
        <span class="bg-main size-2 rounded-full" aria-hidden="true" data-anim="label-dot"></span>
        <p class="body-md-sb text-main">{o.label}</p>
      </div>
      <h2 class="auxiliar-h-lg-skrawk-r text-main" data-anim="title" data-organization-text-line>
        {o.title}
      </h2>
    </div>

    <div class="desktop:grid-cols-[1fr_1fr] desktop:gap-10 grid gap-8">
      <div class="overflow-hidden rounded-lg" data-anim="cover-wrap">
        <img
          src={o.coverImageSrc}
          alt={o.coverImageAlt}
          class="h-full min-h-90 w-full object-cover"
          loading="lazy"
          data-anim="cover-image"
        />
      </div>

      <div
        class="tablet:flex-row desktop:flex-col tablet:gap-6 desktop:gap-10 flex flex-col gap-10"
        data-anim="points"
      >
        {
          o.points.map((point) => (
            <article
              class="bg-light relative flex min-h-70 flex-col justify-end gap-4 rounded-lg p-8"
              data-anim="point-card"
            >
              <img
                src={point.iconSrc}
                alt={point.iconAlt}
                class="pointer-events-none absolute top-6 left-8 h-34 w-auto opacity-40"
                loading="lazy"
                data-anim="point-icon"
              />

              <h3
                class="text-gray text-right text-[2.5rem] leading-[1.4] font-semibold"
                data-anim="point-title"
              >
                {point.title}
              </h3>
              <p
                class="body-md-l text-gray"
                data-anim="point-description"
                data-organization-text-words
              >
                {point.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { initOrganizationSectionAnimation } from './animation';

  const init = () => initOrganizationSectionAnimation();
  document.addEventListener('DOMContentLoaded', init, { once: true });
  document.addEventListener('astro:page-load', init);
</script>
