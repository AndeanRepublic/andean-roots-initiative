---
import { aboutOrganizationContent } from '../../../../data/about-content';
---

<section id="about-organization" class="bg-white px-4 py-12 tablet:px-6 desktop:px-6xl desktop:py-6xl">
  <div class="mx-auto flex w-full max-w-328 flex-col gap-8 desktop:gap-16">
    <div class="flex flex-col gap-4" data-anim="header">
      <div class="flex items-center gap-sm" data-anim="label">
        <span class="size-2 rounded-full bg-main" aria-hidden="true" data-anim="label-dot"></span>
        <p class="body-md-sb text-main">{aboutOrganizationContent.label}</p>
      </div>
      <h2 class="auxiliar-h-lg-skrawk-r text-main" data-anim="title" data-organization-text-line>
        {aboutOrganizationContent.title}
      </h2>
    </div>

    <div class="grid gap-8 desktop:grid-cols-[1fr_1fr] desktop:gap-10">
      <div class="overflow-hidden rounded-lg" data-anim="cover-wrap">
        <img
          src={aboutOrganizationContent.coverImageSrc}
          alt={aboutOrganizationContent.coverImageAlt}
          class="h-full min-h-90 w-full object-cover"
          loading="lazy"
          data-anim="cover-image"
        />
      </div>

      <div class="flex flex-col gap-10" data-anim="points">
        {
          aboutOrganizationContent.points.map((point) => (
            <article class="relative flex min-h-70 flex-col justify-end gap-4 rounded-lg bg-light p-8" data-anim="point-card">
              <img
                src={point.iconSrc}
                alt={point.iconAlt}
                class="pointer-events-none absolute left-8 top-6 h-34 w-auto opacity-40"
                loading="lazy"
                data-anim="point-icon"
              />

              <h3 class="text-right text-[2.5rem] leading-[1.4] font-semibold text-gray" data-anim="point-title">
                {point.title}
              </h3>
              <p class="body-md-l text-gray" data-anim="point-description" data-organization-text-words>
                {point.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { initOrganizationSectionAnimation } from './animation';

  const init = () => initOrganizationSectionAnimation();
  document.addEventListener('DOMContentLoaded', init, { once: true });
  document.addEventListener('astro:page-load', init);
</script>
