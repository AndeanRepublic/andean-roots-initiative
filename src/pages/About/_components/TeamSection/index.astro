---
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const tm = t.aboutPage.team;
---

<section
  id="about-team"
  class="px-2xl desktop:py-6xl relative overflow-hidden bg-white py-12"
>
  <p
    class="pointer-events-none absolute z-0 block text-light leading-[0.8] font-semibold tracking-[-0.35rem] top-10 -right-2 text-[7rem] tablet:top-12 tablet:right-4 tablet:text-[14rem] tablet:tracking-[-0.65rem] desktop:top-14 desktop:right-16 desktop:text-[20rem] desktop:tracking-[-0.8rem]"
    aria-hidden="true"
    data-anim="bg-word"
  >
    {tm.backgroundWord}
  </p>

  <div class="desktop:gap-16 relative mx-auto flex w-full max-w-328 flex-col gap-8">
    <div class="max-w-100 pt-4" data-anim="intro">
      <div class="gap-sm flex items-center" data-anim="label">
        <span class="bg-main size-2 rounded-full" aria-hidden="true"></span>
        <p class="body-md-sb text-main">{tm.label}</p>
      </div>
      <p class="body-md-l text-gray mt-10" data-anim="description" data-team-text-words>
        {tm.description}
      </p>
    </div>

    <div
      class="flex flex-col gap-6 tablet:grid tablet:grid-cols-2 desktop:grid-cols-4 desktop:items-end desktop:gap-6"
      data-anim="cards"
    >
      {
        tm.members.map((member, index) => (
          <article
            class:list={[
              'relative w-3/4 tablet:w-full',
              member.offsetClass ?? '',
              {
                'mr-auto tablet:mx-0': index % 2 === 0,
                'ml-auto tablet:mx-0': index % 2 !== 0,
              },
            ]}
            data-anim="member-card"
          >
            <div class="relative h-115 overflow-hidden rounded-lg" data-anim="member-image-wrap">
              <img
                src={member.imageSrc}
                alt={member.imageAlt}
                class="size-full object-cover"
                loading="lazy"
                data-anim="member-image"
              />
            </div>

            <div
              class="absolute right-4 bottom-4 left-4 flex items-center gap-6 rounded-2xl bg-black/45 px-4 py-2 backdrop-blur-md"
              data-anim="member-caption"
            >
              <div class="flex-1 text-white">
                <p class="text-[1.125rem] leading-[1.4] font-semibold">{member.name}</p>
                <p class="body-sm-l text-light">{member.role}</p>
              </div>
              <span class="body-md-sb text-light flex size-10 items-center justify-center rounded-full bg-white/10">
                IG
              </span>
            </div>
          </article>
        ))
      }
    </div>

    <div class="flex items-center justify-end gap-4" data-anim="controls">
      <button
        type="button"
        aria-label={tm.slider.prevAriaLabel}
        class="border-main text-main flex size-10 items-center justify-center rounded-full border"
        data-anim="control-button"
        data-team-control-hover
      >
        &larr;
      </button>

      <p class="body-md-sb text-main" data-anim="counter">
        {tm.slider.current}
        <span class="body-md-l text-gray">- {tm.slider.total}</span>
      </p>

      <button
        type="button"
        aria-label={tm.slider.nextAriaLabel}
        class="bg-main flex size-10 items-center justify-center rounded-full text-white"
        data-anim="control-button"
        data-team-control-hover
      >
        &rarr;
      </button>
    </div>
  </div>
</section>

<script>
  import { initTeamSectionAnimation } from './animation';

  const init = () => initTeamSectionAnimation();
  document.addEventListener('DOMContentLoaded', init, { once: true });
  document.addEventListener('astro:page-load', init);
</script>
