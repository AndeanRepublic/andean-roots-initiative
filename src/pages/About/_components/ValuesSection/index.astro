---
import CommitmentIcon from '../../../../icons/CommitmentIcon.astro';
import ChakanaIcon from '../../../../icons/chakanaIcon.astro';
import HandshakeIcon from '../../../../icons/HandshakeIcon.astro';
import { aboutValuesContent } from '../../../../data/about-content';
---

<section id="about-values" class="bg-white px-4 py-12 tablet:px-6 desktop:px-6xl desktop:py-6xl">
  <div class="mx-auto flex w-full max-w-328 flex-col gap-8 desktop:gap-16">
    <div class="flex flex-col gap-4" data-anim="header">
      <div class="flex items-center gap-sm" data-anim="label">
        <span class="size-2 rounded-full bg-main" aria-hidden="true" data-anim="label-dot"></span>
        <p class="body-md-sb text-main">{aboutValuesContent.label}</p>
      </div>

      <div class="flex flex-col gap-4 desktop:flex-row desktop:items-start desktop:justify-between desktop:gap-10">
        <h2 class="auxiliar-h-lg-skrawk-r text-main" data-anim="title" data-values-text-line>
          {aboutValuesContent.title}
        </h2>
        <p class="max-w-100 body-md-l text-gray" data-anim="description" data-values-text-words>
          {aboutValuesContent.description}
        </p>
      </div>
    </div>

    <div class="grid gap-6 desktop:grid-cols-3 desktop:gap-10" data-anim="cards">
      {
        aboutValuesContent.items.map((item) => (
          <article class="flex min-h-79 flex-col justify-between gap-8 rounded-lg bg-main p-8 text-white" data-anim="card" data-values-card-tilt>
            <span class="flex size-12 items-center justify-center rounded-full bg-white" data-anim="card-icon">
              {item.icon === 'commitment' && <CommitmentIcon class="size-8" />}
              {item.icon === 'chakana' && <ChakanaIcon class="size-8" />}
              {item.icon === 'handshake' && <HandshakeIcon class="h-5 w-8" />}
            </span>

            <div class="flex flex-col gap-4" data-anim="card-body">
              <h3 class="heading-md-sb text-white">{item.title}</h3>
              <p class="body-md-l text-white" data-values-text-words>{item.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { initValuesSectionAnimation } from './animation';

  const init = () => initValuesSectionAnimation();
  document.addEventListener('DOMContentLoaded', init, { once: true });
  document.addEventListener('astro:page-load', init);
</script>
