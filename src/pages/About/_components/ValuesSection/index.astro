---
import CommitmentIcon from '../../../../icons/CommitmentIcon.astro';
import ChakanaIcon from '../../../../icons/chakanaIcon.astro';
import HandshakeIcon from '../../../../icons/HandshakeIcon.astro';
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const v = t.aboutPage.values;
---

<section id="about-values" class="px-2xl desktop:py-6xl bg-white py-12">
  <div class="desktop:gap-16 mx-auto flex w-full max-w-328 flex-col gap-8">
    <div class="flex flex-col gap-4" data-anim="header">
      <div class="gap-sm flex items-center" data-anim="label">
        <span class="bg-main size-2 rounded-full" aria-hidden="true" data-anim="label-dot"></span>
        <p class="body-md-sb text-main">{v.label}</p>
      </div>

      <div
        class="desktop:flex-row desktop:items-start desktop:justify-between desktop:gap-10 flex flex-col gap-4"
      >
        <h2 class="auxiliar-h-lg-skrawk-r text-main" data-anim="title" data-values-text-line>
          {v.title}
        </h2>
        <p class="body-md-l text-gray max-w-100" data-anim="description" data-values-text-words>
          {v.description}
        </p>
      </div>
    </div>

    <div class="desktop:grid-cols-3 desktop:gap-10 grid gap-6" data-anim="cards">
      {
        v.items.map((item) => (
          <article
            class="desktop:min-h-79 bg-main tablet:min-h-60 flex min-h-70 flex-col justify-between gap-8 rounded-lg p-8 text-white"
            data-anim="card"
            data-values-card-tilt
          >
            <span
              class="flex size-12 items-center justify-center rounded-full bg-white"
              data-anim="card-icon"
            >
              {item.icon === 'commitment' && <CommitmentIcon class="size-8" />}
              {item.icon === 'chakana' && <ChakanaIcon class="size-8" />}
              {item.icon === 'handshake' && <HandshakeIcon class="h-5 w-8" />}
            </span>

            <div class="flex flex-col gap-4" data-anim="card-body">
              <h3 class="heading-md-sb text-white">{item.title}</h3>
              <p class="body-md-l text-white" data-values-text-words>
                {item.description}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { initValuesSectionAnimation } from './animation';

  const init = () => initValuesSectionAnimation();
  document.addEventListener('DOMContentLoaded', init, { once: true });
  document.addEventListener('astro:page-load', init);
</script>
