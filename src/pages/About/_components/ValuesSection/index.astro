---
import Copy from '../../../../components/Copy/index.astro';
import CommitmentIcon from '../../../../icons/CommitmentIcon.astro';
import ChakanaIcon from '../../../../icons/chakanaIcon.astro';
import HandshakeIcon from '../../../../icons/HandshakeIcon.astro';
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const v = t.aboutPage.values;
---

<section id="about-values" class="px-2xl dk:py-6xl bg-white py-12">
  <div class="dk:gap-16 mx-auto flex w-full max-w-328 flex-col gap-8">
    <div class="gap-lg flex flex-col" data-anim="header">
      <div class="gap-sm flex items-center" data-anim="label">
        <span class="bg-main size-2 rounded-full" aria-hidden="true" data-anim="label-dot"></span>
        <p class="body-md-sb text-main">{v.label}</p>
      </div>

      <div class="dk:flex-row dk:items-end dk:justify-between dk:gap-10 flex flex-col gap-4">
        <Copy
          variant="slideFromBottom"
          type="words"
          reverse
          ease="power3.out"
          duration={0.9}
          delay={0}
          stagger={0.2}
          animateOnScroll={true}
          start="top 80%"
          class="w-full"
        >
          <h2 class="section-heading text-main flex w-full flex-col uppercase">
            <span>{v.titleTop}</span>
            <span class="pl-[1.6em]">{v.titleBottom}</span>
          </h2>
        </Copy>
        <Copy
          variant="slideFromBottom"
          type="lines"
          reverse
          ease="power3.out"
          duration={0.9}
          delay={1}
          stagger={0.1}
          animateOnScroll={true}
          start="top 80%"
          class="w-full max-w-100"
        >
          <p class="body-md-l text-gray">{v.description}</p>
        </Copy>
      </div>
    </div>

    <div class="dk:grid-cols-3 dk:gap-10 grid gap-6" data-anim="cards">
      {
        v.items.map((item) => (
          <article
            class="dk:min-h-79 bg-main tb:min-h-60 flex min-h-70 flex-col justify-between gap-8 rounded-lg p-8 text-white"
            data-anim="card"
            data-values-card-tilt
          >
            <span
              class="flex size-12 items-center justify-center rounded-full bg-white"
              data-anim="card-icon"
            >
              {item.icon === 'commitment' && <CommitmentIcon class="size-8" />}
              {item.icon === 'chakana' && <ChakanaIcon class="size-8" />}
              {item.icon === 'handshake' && <HandshakeIcon class="h-5 w-8" />}
            </span>

            <div class="flex flex-col gap-4">
              <h3 class="heading-md-sb text-white">{item.title}</h3>
              <Copy
                variant="slideFromBottom"
                type="lines"
                reverse
                ease="power3.out"
                duration={0.9}
                delay={1}
                stagger={0.1}
                animateOnScroll={true}
                start="top 80%"
                class="w-full"
              >
                <p class="body-md-l text-white">{item.description}</p>
              </Copy>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { initValuesSectionAnimation } from './animation';

  const init = () => initValuesSectionAnimation();

  document.addEventListener('astro:page-load', init);
</script>
