---
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { getLocalizedPath, useTranslations } from '../../../../i18n/utils';
import UpRightArrowIcon from '../../../../icons/UpRightArrowIcon.astro';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const a = t.about;
---

<article
  class="relative z-10 w-full max-w-[28.8125rem] rounded-lg shadow-[0_16px_40px_rgba(34,34,34,0.16)] dk:shadow-none"
  data-anim="origin-card"
>
  <div
    class="rounded-lg bg-white overflow-hidden flex flex-col gap-2xl px-xl py-lg"
    data-anim="origin-card-inner"
  >
    <div class="flex flex-col gap-lg">
      <h3 class="font-manrope text-[length:var(--text-24)] leading-[1.4] font-semibold text-black">
        {a.originTitle}
      </h3>
      <p class="body-sm-l text-gray">{a.originDescription}</p>
    </div>

    <a
      href={getLocalizedPath(lang, a.originCtaHref)}
      class="body-md-sb text-main inline-flex items-center gap-sm"
    >
      {a.originCtaText}
      <UpRightArrowIcon class="text-main size-4" />
    </a>
  </div>
</article>
