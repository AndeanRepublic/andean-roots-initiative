---
import { cn } from '../../../../cn';
import { aboutContent } from '../../../../data/home-content';
---

<div class="gap-xl grid items-center lg:grid-cols-2">
  <div
    class={cn(
      'hidden tablet:flex items-center gap-sm',
      'justify-center tablet:justify-start',
    )}
    data-anim="label"
  >
    <span class="bg-main size-2 rounded-full" aria-hidden="true"></span>
    <p class="body-md-sb text-main">{aboutContent.label}</p>
  </div>

  <h2
    class={cn(
      'flex max-w-150 flex-col justify-center text-main',
      'text-center tablet:text-left',
    )}
    data-anim="title"
  >
    <span class="heading-md-sb" data-about-text-line>{aboutContent.titleTop}</span>
    <span
      class="font-skrawk-serif tablet:text-[4.25rem] text-[3rem] leading-[0.8]"
      data-about-text-line>{aboutContent.titleBottom}</span
    >
  </h2>
</div>
