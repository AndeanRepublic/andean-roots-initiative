---
import { cn } from '../../../../cn';
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const a = t.about;
---

<div class="gap-xl grid items-center lg:grid-cols-2">
  <div
    class={cn('hidden tablet:flex items-center gap-sm', 'justify-center tablet:justify-start')}
    data-anim="label"
  >
    <span class="bg-main size-2 rounded-full" aria-hidden="true"></span>
    <p class="body-md-sb text-main">{a.label}</p>
  </div>

  <h2
    class={cn('flex max-w-150 flex-col justify-center text-main', 'text-center tablet:text-left')}
    data-anim="title"
  >
    <span class="heading-md-sb" data-about-text-line>{a.titleTop}</span>
    <span
      class="font-skrawk-serif tablet:text-[4.25rem] text-[3rem] leading-[0.8]"
      data-about-text-line>{a.titleBottom}</span
    >
  </h2>
</div>
