---
import { cn } from '../../../../cn';
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const a = t.about;
---

<div class="relative z-10 flex w-full flex-col items-center gap-2xl">
  <div class="flex items-center justify-center gap-sm" data-anim="label">
    <span class="bg-main size-2 shrink-0 rounded-full" aria-hidden="true"></span>
    <p class="body-md-sb text-main">{a.label}</p>
  </div>

  <h2 class="flex w-fit max-w-full flex-col items-start text-main" data-anim="title">
    <span class="heading-eyebrow w-full" data-about-text-line>
      {a.titleTop}
    </span>
    <span
      class={cn(
        'flex w-full items-center tb:justify-center',
        'tb:pl-40px dk:pl-120px',
      )}
    >
      <span
        class="section-heading max-w-full uppercase wrap-break-word dk:whitespace-nowrap"
        data-about-text-line
      >
        {a.titleBottom}
      </span>
    </span>
  </h2>
</div>
