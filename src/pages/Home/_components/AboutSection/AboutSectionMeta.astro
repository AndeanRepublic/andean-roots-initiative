---
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';
import AboutTagPill from './AboutTagPill.astro';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const a = t.about;
---

<div class="gap-xl tablet:gap-xl grid items-end lg:grid-cols-2">
  <div class="gap-md flex flex-wrap" data-anim="tags">
    {a.tags.map((tag) => <AboutTagPill label={tag.label} icon={tag.icon} />)}
  </div>

  <p class="body-md-l text-gray" data-anim="description" data-about-text-words>
    {a.description}
  </p>
</div>
