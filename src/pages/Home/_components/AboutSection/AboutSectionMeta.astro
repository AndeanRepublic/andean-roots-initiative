---
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';
import AboutTagPill from './AboutTagPill.astro';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const a = t.about;
---

<div class="relative z-10 flex w-full flex-col items-start gap-6xl">
  <div class="flex w-full justify-end">
    <p
      class="body-md-l w-full max-w-[37.5rem] text-gray"
      data-anim="description"
      data-about-text-words
    >
      {a.description}
    </p>
  </div>

  <div class="flex w-full flex-wrap gap-lg" data-anim="tags">
    {a.tags.map((tag) => <AboutTagPill label={tag.label} icon={tag.icon} />)}
  </div>
</div>
