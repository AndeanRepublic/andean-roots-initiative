---
import Copy from '../../../../components/Copy/index.astro';
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';
import AboutTagPill from './AboutTagPill.astro';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const a = t.about;
---

<div class="gap-6xl relative z-10 flex w-full flex-col items-start">
  <div class="flex w-full justify-end">
    <Copy
      variant="slideFromBottom"
      type="lines"
      reverse
      ease="power3.out"
      duration={0.9}
      delay={1}
      stagger={0.1}
      animateOnScroll={true}
      start="top 80%"
      class="w-full max-w-[37.5rem]"
    >
      <p class="body-md-l text-gray">{a.description}</p>
    </Copy>
  </div>

  <div class="gap-lg flex w-full flex-wrap" data-anim="tags">
    {a.tags.map((tag) => <AboutTagPill label={tag.label} icon={tag.icon} />)}
  </div>
</div>
