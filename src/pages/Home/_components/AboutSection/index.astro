---
import { cn } from '../../../../cn';
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';
import AboutOriginCard from './AboutOriginCard.astro';
import AboutSectionHeading from './AboutSectionHeading.astro';
import AboutSectionMeta from './AboutSectionMeta.astro';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="bg-white px-6xl py-6xl">
  <div class="mx-auto flex w-full max-w-[1312px] flex-col gap-5xl">
    <div class="relative flex flex-col gap-4xl">
      <img
        src="/home-assets/About/about-watermark.svg"
        alt=""
        width="520"
        height="407"
        class="pointer-events-none absolute top-0 left-0 max-w-[40%] select-none"
        aria-hidden="true"
      />
      <AboutSectionHeading lang={lang} />
      <AboutSectionMeta lang={lang} />
    </div>

    <div
      class={cn(
        'rounded-lg relative overflow-hidden',
        'flex flex-col items-start justify-end',
        'p-24px tablet:p-32px desktop:p-40px',
        'h-[22.5rem] tablet:h-[28rem] desktop:h-[35.3125rem]',
      )}
    >
      <img
        src="/home-assets/About/banner-about.png"
        alt={t.about.bannerImageAlt}
        class="absolute inset-0 h-full w-full rounded-lg object-cover object-center"
        loading="lazy"
        data-anim="image"
      />
      <AboutOriginCard lang={lang} />
    </div>
  </div>
</section>

<script>
  import { initAboutSectionAnimation } from './animation';

  const boot = () => initAboutSectionAnimation();

  document.addEventListener('astro:page-load', boot);
</script>
