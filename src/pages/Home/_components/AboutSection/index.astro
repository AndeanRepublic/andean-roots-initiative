---
import { cn } from '../../../../cn';
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';
import AboutOriginCard from './AboutOriginCard.astro';
import AboutSectionHeading from './AboutSectionHeading.astro';
import AboutSectionMeta from './AboutSectionMeta.astro';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
---

<section
  id="about"
  class={cn('bg-white px-2xl', 'pt-6xl', 'pb-[80px] tablet:pb-[48px] desktop:pb-[64px]')}
>
  <div class="gap-4xl mx-auto flex w-full max-w-[1312px] flex-col">
    <div class="gap-4xl tablet:gap-2xl flex flex-col">
      <AboutSectionHeading lang={lang} />
      <AboutSectionMeta lang={lang} />
    </div>

    <div class="relative overflow-visible">
      <div class="overflow-hidden rounded-lg">
        <img
          src="/home-assets/About/banner-about.png"
          alt={t.about.bannerImageAlt}
          class="tablet:h-125 h-90 w-full object-cover object-center"
          loading="lazy"
          data-anim="image"
        />
      </div>
      <AboutOriginCard lang={lang} />
    </div>
  </div>
</section>

<script>
  import { initAboutSectionAnimation } from './animation';

  const boot = () => initAboutSectionAnimation();

  document.addEventListener('astro:page-load', boot);
</script>
