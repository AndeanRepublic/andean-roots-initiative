---
import ComputerIcon from '../../../icons/ComputerIcon.astro';
import GearIcon from '../../../icons/GearIcon.astro';
import ChessHorseIcon from '../../../icons/ChessHorseIcon.astro';
import CartIcon from '../../../icons/CartIcon.astro';

type IconName = 'computer' | 'gear' | 'chess' | 'cart';

interface Props {
  imageSrc: string;
  imageAlt: string;
  title: string;
  description: string;
  icon: IconName;
}

const { imageSrc, imageAlt, title, description, icon } = Astro.props as Props;
---

<article class="action-program-card grid items-stretch gap-[14px] xl:grid-cols-[308px_1fr]">
  <div class="overflow-hidden rounded-lg">
    <img src={imageSrc} alt={imageAlt} class="h-[280px] w-full object-cover" loading="lazy" />
  </div>

  <div class="flex h-[280px] flex-col justify-between rounded-lg bg-light p-xl">
    <span class="flex size-12 items-center justify-center rounded-full bg-main">
      {icon === 'computer' && <ComputerIcon class="h-6 w-8 text-white" />}
      {icon === 'gear' && <GearIcon class="size-7 text-white" />}
      {icon === 'chess' && <ChessHorseIcon class="h-7 w-5 text-white" />}
      {icon === 'cart' && <CartIcon class="h-6 w-6 text-white" />}
    </span>

    <div class="flex flex-col gap-md">
      <h3 class="font-manrope text-[24px] leading-[1.4] font-semibold text-black">{title}</h3>
      <p class="body-md-l text-gray">{description}</p>
    </div>
  </div>
</article>

<style>
  @media (max-width: 768px) {
    .action-program-card img {
      height: 230px;
    }

    .action-program-card > div:last-child {
      height: auto;
      min-height: 230px;
    }
  }
</style>
