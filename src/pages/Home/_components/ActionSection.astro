---
import ActionProgramCard from './ActionProgramCard.astro';
import { actionContent } from '../../../data/home-content';
import { cn } from '../../../cn';
---

<section id="actions" class="bg-white px-6xl py-6xl">
  <div class="mx-auto flex w-full max-w-[1312px] flex-col gap-6xl">
    <div class="flex flex-col gap-lg">
      <div class={cn('flex items-center gap-sm', 'hidden tablet:flex')}>
        <span class="size-2 rounded-full bg-main" aria-hidden="true"></span>
        <p class="body-md-sb text-main">{actionContent.label}</p>
      </div>

      <div class="grid items-end gap-2xl lg:grid-cols-[1fr_25rem]">
        <h2 class="flex max-w-187.75 flex-col text-main items-center tablet:items-start">
          <span class="heading-md-sb">{actionContent.headingTop}</span>
          <span
            class="font-skrawk-serif text-[3rem] leading-[0.8] tablet:text-[4.25rem] text-center tablet:text-start"
            >{actionContent.headingBottom}</span
          >
        </h2>
        <p class="body-md-l pb-sm text-gray">{actionContent.subheading}</p>
      </div>
    </div>

    <div class="grid gap-5xl xl:grid-cols-2">
      {
        actionContent.programs.map((program) => (
          <ActionProgramCard
            imageSrc={program.imageSrc}
            imageAlt={program.imageAlt}
            title={program.title}
            description={program.description}
            icon={program.icon}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  @media (max-width: 1024px) {
    section {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
      padding-top: 3rem;
      padding-bottom: 3rem;
    }
  }

  @media (max-width: 768px) {
    section {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    section h2 > span:last-child {
      font-size: 3rem !important;
    }
  }
</style>
