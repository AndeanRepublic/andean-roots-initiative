---
import { cn } from '../../../../cn';
import ComputerIcon from '../../../../icons/ComputerIcon.astro';
import GearIcon from '../../../../icons/GearIcon.astro';
import ChessHorseIcon from '../../../../icons/ChessHorseIcon.astro';
import CartIcon from '../../../../icons/CartIcon.astro';

type IconName = 'computer' | 'gear' | 'chess' | 'cart';

interface Props {
  imageSrc: string;
  imageAlt: string;
  title: string;
  description: string;
  icon: IconName;
}

const { imageSrc, imageAlt, title, description, icon } = Astro.props as Props;
---

<article data-anim="program-card" class="tb:grid-cols-[1fr_1fr] grid items-stretch gap-[10px]">
  <div class="overflow-hidden rounded-lg">
    <img
      src={imageSrc}
      alt={imageAlt}
      class="tb:h-[280px] h-[230px] w-full object-cover"
      loading="lazy"
    />
  </div>

  <div
    class={cn(
      'flex flex-col justify-between rounded-lg bg-light',
      'tb:h-[280px] tb:min-h-0 ',
      'items-center tb:items-start',
      'gap-5 tb:gap-0',
      'tb:p-[16px] dk:p-[24px] p-[24px]',
    )}
  >
    <span class="bg-main flex size-12 items-center justify-center rounded-full">
      {icon === 'computer' && <ComputerIcon class="h-6 w-8 text-white" />}
      {icon === 'gear' && <GearIcon class="size-7 text-white" />}
      {icon === 'chess' && <ChessHorseIcon class="h-7 w-5 text-white" />}
      {icon === 'cart' && <CartIcon class="h-6 w-6 text-white" />}
    </span>

    <div class={cn('flex flex-col gap-md', 'text-center tb:text-start')}>
      <h3 class="font-manrope text-[24px] leading-[1.4] font-semibold text-black">{title}</h3>
      <p class="body-md-l text-gray">{description}</p>
    </div>
  </div>
</article>
