---
import { cn } from '../../../../cn';
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const a = t.action;
---

<div class="gap-4xl flex flex-col">
  <div class={cn('gap-sm flex items-center', 'justify-center tb:justify-start')} data-anim="label">
    <span class="bg-main size-2 rounded-full" aria-hidden="true"></span>
    <p class="body-md-sb text-main">{a.label}</p>
  </div>

  <div class="gap-2xl grid items-center tb:items-end dk:grid-cols-[minmax(0,46.875rem)_25rem]">
    <h2
      class={cn('text-main flex max-w-[46.875rem] flex-col gap-sm', 'text-center tb:text-start')}
      data-anim="title"
    >
      <span class="heading-eyebrow" data-action-text-line>{a.headingTop}</span>
      <span class="flex flex-col">
        <span class="section-heading tb:whitespace-nowrap uppercase" data-action-text-line>
          {a.headingOpportunity}
        </span>
        <span
          class="section-heading tb:whitespace-nowrap pl-[0.85em] uppercase tb:pl-[1.6em] dk:pl-[2.35em]"
          data-action-text-line
        >
          {a.headingSustainable}
        </span>
      </span>
    </h2>
    <p class="body-md-l text-gray tb:pb-sm" data-anim="subheading" data-action-text-words>
      {a.subheading}
    </p>
  </div>
</div>
