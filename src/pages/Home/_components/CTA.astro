---
import ButtonLink from '../../../components/ButtonLink.astro';
import { ctaContent } from '../../../data/home-content';
---

<section
  id="impacto"
  class="bg-white px-4 py-12 tablet:px-6 desktop:px-6xl desktop:py-6xl"
>
  <div class="mx-auto w-full max-w-328">
    <div
      class="relative flex min-h-88 flex-col items-center justify-center overflow-hidden rounded-lg bg-main px-6 py-12 tablet:min-h-112 tablet:px-10 tablet:py-16 desktop:min-h-125 desktop:px-8xl desktop:py-6xl"
    >
      <img
        src="/home-assets/Numbers/vector.png"
        alt=""
        class="pointer-events-none absolute inset-0 size-full object-cover opacity-25"
        loading="lazy"
        aria-hidden="true"
      />

      <div
        class="relative z-10 flex w-full max-w-150 flex-col items-center gap-8 text-center tablet:gap-10 desktop:gap-20"
      >
        <h2
          class="font-skrawk-serif text-[2rem] leading-[0.8] text-white tablet:text-[3rem] desktop:text-[3.5rem] desktop:leading-[0.8]"
        >
          {ctaContent.title}
        </h2>
        <p class="body-md-l max-w-150 text-light">
          {ctaContent.description}
        </p>
        <div class="flex w-full justify-center">
          <ButtonLink
            class="hidden tablet:inline-flex"
            href={ctaContent.ctaHref}
            text={ctaContent.ctaText}
            variant="desktop-primary-inverse"
          />
          <ButtonLink
            class="tablet:hidden"
            href={ctaContent.ctaHref}
            text={ctaContent.ctaText}
            variant="mobile-primary-inverse"
          />
        </div>
      </div>
    </div>
  </div>
</section>
