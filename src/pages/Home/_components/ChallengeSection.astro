---
import TargetIcon from '../../../icons/TargetIcon.astro';
import BreakChainIcon from '../../../icons/BreakChainIcon.astro';
import { challengeContent } from '../../../data/home-content';
import { cn } from '../../../cn';
---

<section id="vision" class={cn('bg-white px-2xl py-6xl', 'tablet:px-6 tablet:py-12')}>
  <div class="mx-auto flex w-full max-w-[1312px] flex-col items-center gap-4xl">
    <div class="flex w-full max-w-[1000px] flex-col items-center gap-4xl">
      <div class="items-center justify-center gap-sm rounded-full hidden tablet:flex">
        <span class="size-2 rounded-full bg-main" aria-hidden="true"></span>
        <p class="body-md-sb text-main">{challengeContent.label}</p>
      </div>
      <p class="heading-lg-sb text-main tablet:hidden text-center">
        {
          challengeContent.label.charAt(0).toUpperCase() +
            challengeContent.label.slice(1).toLowerCase()
        }
      </p>

      <p class="max-w-[900px] text-center text-black heading-md-sb">
        {challengeContent.introStart}
        <span class="text-gray">
          {challengeContent.introMutedStart}
        </span>
        {challengeContent.introHighlight}
        <span class="text-gray">{challengeContent.introEnd}</span>
      </p>
    </div>

    <div class="challenge-cards grid w-full max-w-[948px] gap-xl lg:grid-cols-3">
      <article
        class={cn(
          'challenge-card flex flex-col justify-between rounded-lg bg-stone-200 p-xl',
          'tablet:h-[350px] h-[250px]',
        )}
      >
        <h3 class="font-manrope text-[24px] leading-[1.4] font-semibold text-main">
          {challengeContent.firstCardTitle}
        </h3>

        <div class="flex flex-col gap-sm">
          <p
            class="font-skrawk-serif text-[3rem] leading-[1.2] tracking-[-2px] text-black max-md:text-[40px]"
          >
            {challengeContent.firstCardHeadline}
          </p>
          <p class="body-sm-l text-black">{challengeContent.firstCardDescription}</p>
        </div>
      </article>

      <article
        class="challenge-card relative flex h-[350px] flex-col justify-between overflow-hidden rounded-lg p-xl text-white"
      >
        <img
          src="/home-assets/Problem/2.png"
          alt={challengeContent.secondCardImageAlt}
          class="absolute inset-0 size-full object-cover"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-linear-to-b from-black/0 to-black/60"></div>

        <div class="relative z-10 flex">
          <span
            class="flex size-12 items-center justify-center rounded-full border border-white/30 bg-main/25 backdrop-blur-sm"
          >
            <TargetIcon class="size-6 text-white" />
          </span>
        </div>

        <div class="relative z-10 flex flex-col gap-sm">
          <h3 class="font-skrawk-serif text-[2.25rem] leading-[1.4] text-white max-md:text-[44px]">
            {challengeContent.secondCardTitle}
          </h3>
          <p class="body-sm-l text-white">{challengeContent.secondCardDescription}</p>
        </div>
      </article>

      <article
        class={cn(
          'challenge-card flex flex-col justify-between rounded-lg bg-main p-xl text-white',
          'tablet:h-[350px] h-[280px]',
        )}
      >
        <div class="flex flex-col gap-lg">
          <p class="body-sm-l text-white text-center">{challengeContent.thirdCardTag}</p>
          <h3
            class="font-skrawk-serif text-center text-[2.25rem] leading-[0.8] text-white max-md:text-[44px]"
          >
            {challengeContent.thirdCardTitle}
          </h3>
        </div>

        <div class="flex flex-col gap-md">
          <div class="flex items-center gap-[-1rem] z-0">
            <img
              src="/home-assets/Problem/hands image.png"
              alt={challengeContent.thirdCardImageAlt}
              class="z-0 size-[70px] rounded-full object-cover"
              loading="lazy"
            />
            <span
              class="-ml-4 flex size-[70px] items-center justify-center rounded-full bg-light z-10"
            >
              <BreakChainIcon class="size-10 text-black" />
            </span>
          </div>

          <p class="body-sm-l text-light">{challengeContent.thirdCardDescription}</p>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  let mm: ReturnType<typeof gsap.matchMedia> | null = null;

  const initChallengeReveal = () => {
    const section = document.querySelector('#vision');
    const cards = section?.querySelectorAll('.challenge-card');
    if (!section || !cards || cards.length === 0) return;

    mm?.revert();
    mm = null;

    ScrollTrigger.getAll()
      .filter((trigger) => trigger.vars?.id === 'challenge-reveal')
      .forEach((trigger) => trigger.kill());

    gsap.killTweensOf(cards);
    gsap.set(cards, { clearProps: 'all' });

    mm = gsap.matchMedia();
    mm.add('(min-width: 1200px)', () => {
      gsap.fromTo(
        cards,
        {
          y: 70,
          opacity: 0,
          rotateX: -10,
          transformOrigin: 'top center',
        },
        {
          y: 0,
          opacity: 1,
          rotateX: 0,
          duration: 0.9,
          ease: 'power3.out',
          stagger: 0.14,
          scrollTrigger: {
            id: 'challenge-reveal',
            trigger: section,
            start: 'top 80%',
            once: true,
          },
        },
      );
    });

    mm.add('(max-width: 1199px)', () => {
      gsap.fromTo(
        cards,
        { y: 40, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.7,
          ease: 'power2.out',
          stagger: 0.1,
          scrollTrigger: {
            id: 'challenge-reveal',
            trigger: section,
            start: 'top 88%',
            once: true,
          },
        },
      );
    });

    // Ensure trigger positions are recalculated after layout settles.
    requestAnimationFrame(() => ScrollTrigger.refresh());
  };

  const bootChallengeReveal = () => initChallengeReveal();

  // First full-page load
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bootChallengeReveal);
  else bootChallengeReveal();

  // Re-init when Astro performs client-side navigations/swaps
  document.addEventListener('astro:page-load', bootChallengeReveal);
</script>
