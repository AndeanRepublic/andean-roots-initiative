---
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';
import { cn } from '../../../../cn';

interface Props {
	lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const c = t.challenge;
---

<div class="gap-4xl flex w-full max-w-250 flex-col items-center">
	<h2
		class={cn(
			'w-full text-center text-main',
			'font-fredericka font-normal ',
			'text-[1.75rem] tb:text-[2.25rem] dk:text-[2.8125rem]',
			'leading-[1.3]',
		)}
		data-anim="intro-title"
	>
		{c.label}
	</h2>

	<p
		class={cn(
			'w-full text-center font-manrope font-medium',
			'text-[1.25rem] tb:text-[1.5rem] dk:text-[2rem] leading-[1.4]',
		)}
		data-challenge-intro-reveal
	>
		<span data-intro-segment>{c.introStart}</span>
		<span class="text-gray" data-intro-segment>
			{c.introMutedStart}
		</span>
		<span data-intro-segment>{c.introHighlight}</span>
		<span class="text-gray" data-intro-segment>{c.introEnd}</span>
	</p>
</div>
