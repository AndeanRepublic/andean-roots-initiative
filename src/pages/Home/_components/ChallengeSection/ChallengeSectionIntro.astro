---
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';
import { cn } from '../../../../cn';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const c = t.challenge;
---

<div class="gap-xl flex w-full max-w-[1000px] flex-col items-center">
  <div class="gap-sm tb:flex hidden items-center justify-center rounded-full">
    <span class="bg-main size-2 rounded-full" aria-hidden="true"></span>
    <p class="body-md-sb text-main">{c.label}</p>
  </div>

  <p class="heading-lg-sb text-main tb:hidden text-center">
    {c.label.charAt(0).toUpperCase() + c.label.slice(1).toLowerCase()}
  </p>

  <p
    class={cn(
      'text-[1.25rem] tb:text-[1.5rem] dk-lg:text-[2rem]',
      'font-nunito-sans font-semibold leading-[140%] tracking-normal text-black',
      'max-w-[900px] text-center',
    )}
    data-challenge-intro-reveal
  >
    <span data-intro-segment>{c.introStart}</span>
    <span class="text-gray" data-intro-segment>
      {c.introMutedStart}
    </span>
    <span data-intro-segment>{c.introHighlight}</span>
    <span class="text-gray" data-intro-segment>{c.introEnd}</span>
  </p>
</div>
