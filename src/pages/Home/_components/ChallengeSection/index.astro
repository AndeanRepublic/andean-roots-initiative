---
import { cn } from '../../../../cn';
import ChallengeSectionIntro from './ChallengeSectionIntro.astro';
import ChallengeFlipCardsDesktop from './ChallengeFlipCardsDesktop.astro';
import ChallengeCardsMobile from './ChallengeCardsMobile.astro';
---

<section
  id="challenge"
  class={cn('sticky-section', 'bg-white px-2xl py-6xl', 'tablet:px-6 tablet:py-12')}
>
  <div class="gap-md mx-auto flex w-full max-w-[1312px] flex-col items-center">
    <ChallengeSectionIntro />
    <ChallengeFlipCardsDesktop />
    <ChallengeCardsMobile />
  </div>
</section>

<script>
  import { initChallengeSectionCards } from './animation';

  const boot = () => initChallengeSectionCards();

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();

  document.addEventListener('astro:page-load', boot);
</script>
