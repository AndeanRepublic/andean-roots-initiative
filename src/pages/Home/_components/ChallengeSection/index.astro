---
import TargetIcon from '../../../../icons/TargetIcon.astro';
import BreakChainIcon from '../../../../icons/BreakChainIcon.astro';
import { challengeContent } from '../../../../data/home-content';
import { cn } from '../../../../cn';
---

<section
  id="challenge"
  class={cn('sticky-section', 'bg-white px-2xl py-6xl', 'tablet:px-6 tablet:py-12')}
>
  <div class="gap-md mx-auto flex w-full max-w-[1312px] flex-col items-center">
    <div class="gap-xl flex w-full max-w-[1000px] flex-col items-center">
      <div class="gap-sm tablet:flex hidden items-center justify-center rounded-full">
        <span class="bg-main size-2 rounded-full" aria-hidden="true"></span>
        <p class="body-md-sb text-main">{challengeContent.label}</p>
      </div>
      <p class="heading-lg-sb text-main tablet:hidden text-center">
        {
          challengeContent.label.charAt(0).toUpperCase() +
            challengeContent.label.slice(1).toLowerCase()
        }
      </p>

      <p
        class={cn(
          'text-[1.25rem] tablet:text-[1.5rem] desktop-lg:text-[2rem]',
          'font-nunito-sans font-semibold leading-[140%] tracking-normal text-black',
          'max-w-[900px] text-center',
        )}
        data-challenge-intro-reveal
      >
        <span data-intro-segment>{challengeContent.introStart}</span>
        <span class="text-gray" data-intro-segment>
          {challengeContent.introMutedStart}
        </span>
        <span data-intro-segment>{challengeContent.introHighlight}</span>
        <span class="text-gray" data-intro-segment>{challengeContent.introEnd}</span>
      </p>
    </div>

    <!-- Desktop / viewport: cards flip -->
    <div class="desktop:block hidden w-full">
      <section
        class={cn('challenge-flip-stage', 'relative flex w-full items-center justify-center')}
      >
        <div
          class={cn(
            'card-container',
            'relative flex w-[75%] max-w-[948px] translate-y-10 will-change-[width]',
            'perspective-[1000px]',
          )}
        >
          <!-- Card 1 -->
          <div
            class={cn(
              'card',
              'relative flex-1 aspect-5/7 transform-3d origin-[top_center]',
              'rounded-[20px_0_0_20px]',
            )}
            id="card-1"
          >
            <!-- Front -->
            <div
              class={cn(
                'card-front',
                'absolute inset-0 size-full overflow-hidden rounded-[inherit] backface-hidden',
              )}
            >
              <img
                class="size-full object-cover"
                src={challengeContent.firstCardCoverSrc}
                alt=""
                loading="lazy"
              />
            </div>
            <!-- Back -->
            <div
              class={cn(
                'card-back',
                'absolute inset-0 flex size-full flex-col items-stretch justify-stretch overflow-hidden rounded-[inherit] p-0 text-left backface-hidden',
                'transform-[rotateY(180deg)]',
              )}
            >
              <div
                class={cn(
                  'flex h-full min-h-0 w-full flex-col justify-between rounded-[inherit] bg-stone-200 p-xl text-left',
                  'tablet:min-h-[350px] min-h-[250px]',
                )}
              >
                <h3 class="font-manrope text-main text-[24px] leading-[1.4] font-semibold">
                  {challengeContent.firstCardTitle}
                </h3>
                <div class="gap-sm flex flex-col">
                  <p
                    class="font-skrawk-serif text-[3rem] leading-[1.2] tracking-[-2px] text-black max-md:text-[40px]"
                  >
                    {challengeContent.firstCardHeadline}
                  </p>
                  <p class="body-sm-l text-black">{challengeContent.firstCardDescription}</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 2 -->
          <div
            class={cn('card', 'relative flex-1 aspect-5/7 transform-3d origin-[top_center]')}
            id="card-2"
          >
            <!-- Front -->
            <div
              class={cn(
                'card-front',
                'absolute inset-0 size-full overflow-hidden rounded-[inherit] backface-hidden',
              )}
            >
              <img
                class="size-full object-cover"
                src={challengeContent.secondCardCoverSrc}
                alt=""
                loading="lazy"
              />
            </div>
            <!-- Back -->
            <div
              class={cn(
                'card-back',
                'absolute inset-0 flex size-full flex-col items-stretch justify-stretch overflow-hidden rounded-[inherit] p-0 text-left backface-hidden',
                'transform-[rotateY(180deg)]',
              )}
            >
              <div
                class="p-xl relative flex h-full min-h-0 w-full flex-col justify-between overflow-hidden rounded-[inherit] text-white"
              >
                <img
                  src="/home-assets/Problem/2.png"
                  alt={challengeContent.secondCardImageAlt}
                  class="absolute inset-0 size-full object-cover"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-linear-to-b from-black/0 to-black/60"></div>
                <div class="relative z-10 flex">
                  <span
                    class="bg-main/25 flex size-12 items-center justify-center rounded-full border border-white/30 backdrop-blur-sm"
                  >
                    <TargetIcon class="size-6 text-white" />
                  </span>
                </div>
                <div class="gap-sm relative z-10 flex flex-col">
                  <h3
                    class="font-skrawk-serif text-[2.25rem] leading-[1.4] text-white max-md:text-[44px]"
                  >
                    {challengeContent.secondCardTitle}
                  </h3>
                  <p class="body-sm-l text-white">{challengeContent.secondCardDescription}</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 3 -->
          <div
            class={cn(
              'card',
              'relative flex-1 aspect-5/7 transform-3d origin-[top_center]',
              'rounded-[0_20px_20px_0]',
            )}
            id="card-3"
          >
            <!-- Front -->
            <div
              class={cn(
                'card-front',
                'absolute inset-0 size-full overflow-hidden rounded-[inherit] backface-hidden',
              )}
            >
              <img
                class="size-full object-cover"
                src={challengeContent.thirdCardCoverSrc}
                alt=""
                loading="lazy"
              />
            </div>
            <!-- Back -->
            <div
              class={cn(
                'card-back',
                'absolute inset-0 flex size-full flex-col items-stretch justify-stretch overflow-hidden rounded-[inherit] p-0 text-left backface-hidden',
                'transform-[rotateY(180deg)]',
              )}
            >
              <div
                class={cn(
                  'flex h-full min-h-0 w-full flex-col justify-between rounded-[inherit] bg-main p-xl text-white',
                  'tablet:min-h-[350px] min-h-[280px]',
                )}
              >
                <div class="gap-lg flex flex-col">
                  <p class="body-sm-l text-center text-white">{challengeContent.thirdCardTag}</p>
                  <h3
                    class="font-skrawk-serif text-center text-[2.25rem] leading-[0.8] text-white max-md:text-[44px]"
                  >
                    {challengeContent.thirdCardTitle}
                  </h3>
                </div>
                <div class="gap-md flex flex-col">
                  <div class="z-0 flex items-center gap-[-1rem]">
                    <img
                      src="/home-assets/Problem/hands image.png"
                      alt={challengeContent.thirdCardImageAlt}
                      class="z-0 size-[70px] rounded-full object-cover"
                      loading="lazy"
                    />
                    <span
                      class="bg-light z-10 -ml-4 flex size-[70px] items-center justify-center rounded-full"
                    >
                      <BreakChainIcon class="size-10 text-black" />
                    </span>
                  </div>
                  <p class="body-sm-l text-light">{challengeContent.thirdCardDescription}</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- Solo móvil y tablet / viewport: cards planas (sin flip) -->
    <div
      class={cn(
        'challenge-cards-mobile grid w-full max-w-[948px] gap-xl lg:grid-cols-3',
        'desktop:hidden',
      )}
    >
      <article
        class={cn(
          'flex flex-col justify-between rounded-lg bg-stone-200 p-xl',
          'tablet:h-[350px] h-[250px]',
        )}
      >
        <h3 class="font-manrope text-main text-[24px] leading-[1.4] font-semibold">
          {challengeContent.firstCardTitle}
        </h3>

        <div class="gap-sm flex flex-col">
          <p
            class="font-skrawk-serif text-[3rem] leading-[1.2] tracking-[-2px] text-black max-md:text-[40px]"
          >
            {challengeContent.firstCardHeadline}
          </p>
          <p class="body-sm-l text-black">{challengeContent.firstCardDescription}</p>
        </div>
      </article>

      <article
        class="p-xl relative flex h-[350px] flex-col justify-between overflow-hidden rounded-lg text-white"
      >
        <img
          src="/home-assets/Problem/2.png"
          alt={challengeContent.secondCardImageAlt}
          class="absolute inset-0 size-full object-cover"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-linear-to-b from-black/0 to-black/60"></div>

        <div class="relative z-10 flex">
          <span
            class="bg-main/25 flex size-12 items-center justify-center rounded-full border border-white/30 backdrop-blur-sm"
          >
            <TargetIcon class="size-6 text-white" />
          </span>
        </div>

        <div class="gap-sm relative z-10 flex flex-col">
          <h3 class="font-skrawk-serif text-[2.25rem] leading-[1.4] text-white max-md:text-[44px]">
            {challengeContent.secondCardTitle}
          </h3>
          <p class="body-sm-l text-white">{challengeContent.secondCardDescription}</p>
        </div>
      </article>

      <article
        class={cn(
          'flex flex-col justify-between rounded-lg bg-main p-xl text-white',
          'tablet:h-[350px] h-[280px]',
        )}
      >
        <div class="gap-lg flex flex-col">
          <p class="body-sm-l text-center text-white">{challengeContent.thirdCardTag}</p>
          <h3
            class="font-skrawk-serif text-center text-[2.25rem] leading-[0.8] text-white max-md:text-[44px]"
          >
            {challengeContent.thirdCardTitle}
          </h3>
        </div>

        <div class="gap-md flex flex-col">
          <div class="z-0 flex items-center gap-[-1rem]">
            <img
              src="/home-assets/Problem/hands image.png"
              alt={challengeContent.thirdCardImageAlt}
              class="z-0 size-[70px] rounded-full object-cover"
              loading="lazy"
            />
            <span
              class="bg-light z-10 -ml-4 flex size-[70px] items-center justify-center rounded-full"
            >
              <BreakChainIcon class="size-10 text-black" />
            </span>
          </div>

          <p class="body-sm-l text-light">{challengeContent.thirdCardDescription}</p>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  import { initChallengeSectionCards } from './animation';

  const boot = () => initChallengeSectionCards();

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();

  document.addEventListener('astro:page-load', boot);
</script>
