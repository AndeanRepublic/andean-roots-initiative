---
import ButtonLink from '../../../components/ButtonLink.astro';
import DownArrowIcon from '../../../icons/DownArrowIcon.astro';
import { heroContent } from '../../../data/home-content';
import { cn } from '../../../cn';

interface Props {
  titleTop?: string;
  titleBottom?: string;
  subheading?: string;
  ctaText?: string;
  ctaHref?: string;
}

const {
  titleTop = heroContent.titleTop,
  titleBottom = heroContent.titleBottom,
  subheading = heroContent.subheading,
  ctaText = heroContent.ctaText,
  ctaHref = heroContent.ctaHref,
} = Astro.props;
---

<section
  class="hero relative flex h-screen min-h-dvh w-full flex-col justify-end overflow-hidden px-6xl pt-3xl pb-6xl"
>
  <div class="absolute inset-0" aria-hidden="true">
    <img
      src="/home-assets/Hero/Hero.png"
      alt=""
      class="absolute inset-0 size-full object-cover object-center"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-linear-to-b from-black/0 to-black/70"></div>
  </div>

  <div
    class="hero__body relative z-10 flex w-full max-w-[1312px] items-end justify-between self-center"
  >
    <div class="flex max-w-5xl flex-col gap-xl">
      <h1 class="hero__title text-white flex flex-col">
        <span
          class={cn(
            ' font-skrawk-serif font-normal ',
            'text-[6rem] desktop:text-[10rem]',
            'leading-[0.8]',
          )}>{titleTop}</span
        >
        <span class="heading-xl-sb">{titleBottom}</span>
      </h1>
      <div
        class={cn(
          'flex justify-between items-center gap-3xl',
          'tablet:gap-4xl desktop:gap-6xl',
          'flex-col tablet:flex-row',
        )}
      >
        <p class="max-w-[520px] body-md-sb text-white">{subheading}</p>
        <ButtonLink href={ctaHref} text={ctaText} variant="desktop-primary" class="hero__cta" />
      </div>
    </div>

    <a
      href="#vision"
      class={cn(
        'hero__scroll flex flex-col items-center gap-lg text-white transition-opacity hover:opacity-80',
        'hidden tablet:flex',
      )}
      aria-label={heroContent.scrollAriaLabel}
    >
      <span class="flex items-center rounded-full border border-white/60 px-sm py-lg">
        <DownArrowIcon class="size-4 text-white" />
      </span>
      <span class="body-sm-l uppercase tracking-wide">{heroContent.scrollLabel}</span>
    </a>
  </div>
</section>

<style>
  @media (max-width: 1024px) {
    .hero__body {
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }

    .hero__scroll {
      align-self: center;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding-left: 1rem;
      padding-right: 1rem;
      padding-top: 1.5rem;
      padding-bottom: 2rem;
    }

    .hero h1 {
      font-size: 2rem !important;
      line-height: 1.2 !important;
    }

    .hero__body > div {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
