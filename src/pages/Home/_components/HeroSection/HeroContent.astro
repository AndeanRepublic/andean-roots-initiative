---
import { cn } from '../../../../cn';
import ButtonLink from '../../../../components/ButtonLink.astro';

interface Props {
  titleTop: string;
  titleBottom: string;
  subheading: string;
  ctaText: string;
  ctaHref: string;
}

const { titleTop, titleBottom, subheading, ctaText, ctaHref } = Astro.props as Props;
---

<div class="hero__content gap-xl flex max-w-5xl flex-col items-start">
  <h1 class="hero__title space-y-md flex flex-col text-white">
    <span
      class={cn(
        'hero__title-line',
        'font-skrawk-serif font-normal',
        'text-[5.5rem] leading-[0.8] tablet:text-[6rem] tablet:leading-[0.8] desktop:text-[10rem]',
      )}
      data-anim="title-line">{titleTop}</span
    >
    <span class="hero__title-line heading-xl-sb" data-anim="title-line">{titleBottom}</span>
  </h1>

  <div
    class={cn(
      'flex justify-between items-center gap-3xl',
      'tablet:gap-4xl desktop:gap-6xl',
      'flex-col tablet:flex-row',
    )}
  >
    <p class="hero__subtitle body-md-sb max-w-[520px] text-white" data-anim="subtitle">
      {subheading}
    </p>
    <div data-anim="cta">
      <ButtonLink href={ctaHref} text={ctaText} device="desktop" kind="primary" class="hero__cta" />
    </div>
  </div>
</div>
