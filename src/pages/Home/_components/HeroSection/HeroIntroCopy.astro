---
import ButtonLink from '../../../../components/ButtonLink/index.astro';
import { cn } from '../../../../cn';

interface Props {
  subheading: string;
  ctaText: string;
  ctaHref: string;
}

const { subheading, ctaText, ctaHref } = Astro.props as Props;
---

<div
  class={cn(
    'flex flex-col items-end dk:shrink-0',
    'gap-3xl w-full max-w-none dk:w-[21.5625rem]',
  )}
>
  <p data-hero-sub class="hero__subtitle body-md-sb w-full text-right wrap-break-word text-white">
    {subheading}
  </p>
  <div data-hero-cta class="shrink-0">
    <ButtonLink
      href={ctaHref}
      text={ctaText}
      device="desktop"
      kind="primary-inverse"
      class="hero__cta"
    />
  </div>
</div>
