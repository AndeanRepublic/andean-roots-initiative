---
interface Props {
  imageSrc: string;
}

const { imageSrc } = Astro.props as Props;
---

<div class="hero__bg absolute inset-0 z-0" aria-hidden="true">
  <div class="hero-img absolute inset-0">
    <img
      src={imageSrc}
      alt=""
      class="absolute inset-0 h-full w-full object-cover object-center"
      fetchpriority="high"
    />
  </div>
  <div
    class="hero__bg-gradient pointer-events-none absolute inset-0 bg-linear-to-b from-black/0 to-black/70"
  >
  </div>
</div>
