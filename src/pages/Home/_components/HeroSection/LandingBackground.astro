---
interface Props {
  imageSrc: string;
}

const { imageSrc } = Astro.props as Props;
---

<div class="hero__bg absolute inset-0 z-0" data-anim="bg" aria-hidden="true">
  <img src={imageSrc} alt="" class="hero__bg-img" data-anim="bg-image" fetchpriority="high" />
  <div
    class="hero__bg-gradient pointer-events-none absolute inset-0 bg-linear-to-b from-black/0 to-black/70"
  >
  </div>
</div>

<style>
  .hero__bg {
    clip-path: polygon(50% 50%, 50% 50%, 50% 50%, 50% 50%);
    will-change: clip-path;
  }

  .hero__bg-img {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
    transform: translate(-50%, -50%) scale(0.6);
    will-change: transform;
  }
</style>
