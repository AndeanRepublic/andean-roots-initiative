---
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';
import LandingBackground from './LandingBackground.astro';
import LandingContent from './LandingContent.astro';
import LandingScrollHint from './LandingScrollHint.astro';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const heroContent = t.hero;
---

<section
  class="hero bg-main px-2xl tablet:pt-3xl tablet:pb-6xl relative flex h-screen min-h-dvh w-full flex-col justify-end overflow-hidden pt-6 pb-8"
>
  <LandingBackground imageSrc="/home-assets/Hero/Hero.png" />

  <div
    class="hero__body desktop:flex-row desktop:items-end desktop:justify-between desktop:gap-0 relative z-10 flex w-full max-w-[1312px] flex-col items-start gap-8 self-center"
  >
    <LandingContent
      titleTop={heroContent.titleTop}
      titleBottom={heroContent.titleBottom}
      subheading={heroContent.subheading}
      ctaText={heroContent.ctaText}
      ctaHref={heroContent.ctaHref}
    />

    <LandingScrollHint ariaLabel={heroContent.scrollAriaLabel} label={heroContent.scrollLabel} />
  </div>
</section>

<script>
  import { initHomeHeroIntroAnimation } from './animation';

  const boot = () => initHomeHeroIntroAnimation();

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();

  document.addEventListener('astro:page-load', boot);
</script>
