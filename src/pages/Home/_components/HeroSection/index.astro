---
import { heroContent } from '../../../../data/home-content';
import HeroBackground from './HeroBackground.astro';
import HeroContent from './HeroContent.astro';
import HeroScrollHint from './HeroScrollHint.astro';
---

<section
  class="hero relative flex h-screen min-h-dvh w-full flex-col justify-end overflow-hidden bg-main px-4 pt-6 pb-8 tablet:px-6xl tablet:pt-3xl tablet:pb-6xl"
>
  <HeroBackground imageSrc="/home-assets/Hero/Hero.png" />

  <div
    class="hero__body relative z-10 flex w-full max-w-[1312px] flex-col items-start gap-8 self-center desktop:flex-row desktop:items-end desktop:justify-between desktop:gap-0"
  >
    <HeroContent
      titleTop={heroContent.titleTop}
      titleBottom={heroContent.titleBottom}
      subheading={heroContent.subheading}
      ctaText={heroContent.ctaText}
      ctaHref={heroContent.ctaHref}
    />

    <HeroScrollHint ariaLabel={heroContent.scrollAriaLabel} label={heroContent.scrollLabel} />
  </div>
</section>

<script>
  import { initHomeHeroIntroAnimation } from './animation';

  const boot = () => initHomeHeroIntroAnimation();

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();

  document.addEventListener('astro:page-load', boot);
</script>

<style>
  .hero__bg {
    clip-path: polygon(50% 50%, 50% 50%, 50% 50%, 50% 50%);
    will-change: clip-path;
  }

  .hero__bg-img {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: translate(-50%, -50%) scale(0.6);
    will-change: transform;
  }
</style>
