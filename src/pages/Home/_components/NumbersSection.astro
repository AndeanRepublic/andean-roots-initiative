---
import WorldIcon from '../../../icons/WorldIcon.astro';
import { numbersContent } from '../../../data/home-content';
---

<section id="impact" class="bg-white px-4 py-12 tablet:px-6 desktop:px-6xl desktop:py-6xl">
  <div class="mx-auto w-full max-w-328">
    <div class="relative overflow-hidden rounded-lg bg-main px-6 py-10 tablet:px-10">
      <img
        src="/home-assets/Numbers/vector.png"
        alt=""
        class="pointer-events-none absolute inset-0 size-full object-cover opacity-25"
        loading="lazy"
        aria-hidden="true"
      />

      <div class="relative flex flex-col gap-10 desktop:flex-row desktop:items-end desktop:justify-between">
        <div class="flex max-w-90 flex-col gap-10">
          <span class="flex size-10 items-center justify-center rounded-full bg-light p-2">
            <WorldIcon class="size-6" />
          </span>

          <p class="body-md-l text-white">{numbersContent.description}</p>
        </div>

        <div class="grid flex-1 gap-8 tablet:grid-cols-3">
          {numbersContent.stats.map((stat) => (
            <article class="flex flex-col gap-sm">
              <p class="heading-lg-sb text-white">{stat.value}</p>
              <p class="body-md-l text-light">{stat.label}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
