---
import { cn } from '../../../../cn';

interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props as Props;
---

<article
  data-anim="stat-card"
  class={cn('flex flex-col gap-sm', 'items-center tb:items-start ')}
>
  <p
    data-anim="stat-value"
    data-numbers-counter={value}
    class={cn(
      'text-[4rem] tb:text-[2.625rem] dk:text-[3.5rem]',
      'font-nunito-sans font-semibold leading-none tracking-normal text-white',
    )}
  >
    {value}
  </p>
  <p class="body-md-l text-light">{label}</p>
</article>
