---
import { cn } from '../../../cn';
import { partnersContent } from '../../../data/home-content';
---

<section id="partners" class="bg-white px-4 py-12 tablet:px-6 desktop:px-6xl desktop:py-6xl">
  <div
    class="mx-auto flex w-full max-w-328 flex-col gap-8 py-8 desktop:flex-row desktop:items-center desktop:gap-10 desktop:py-16"
  >
    <div
      class="flex shrink-0 flex-col gap-1 border-r-0 border-gray/50 pb-8 desktop:border-r desktop:pb-0 desktop:pr-10"
    >
      <div class="items-center justify-start gap-sm rounded-full hidden tablet:flex">
        <span class="size-2 rounded-full bg-main" aria-hidden="true"></span>
        <p class="body-md-sb text-main">{partnersContent.label}</p>
      </div>
      <p class="heading-lg-sb text-main tablet:hidden text-center pb-4">
        {
          partnersContent.label.charAt(0).toUpperCase() +
            partnersContent.label.slice(1).toLowerCase()
        }
      </p>
      <p class="max-w-[400px] body-md-l text-gray">{partnersContent.description}</p>
    </div>

    <div
      class={cn(
        'flex min-h-0 min-w-0 flex-1 flex-wrap items-center justify-center desktop:justify-start desktop:gap-12',
        'gap-8 ',
      )}
    >
      {
        partnersContent.logos.map((logo: { src: string; alt: string }) => (
          <div class="w-36 desktop:w-40 h-full overflow-hidden">
            <img
              src={logo.src}
              alt={logo.alt}
              class="w-full h-auto object-contain "
              loading="lazy"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
