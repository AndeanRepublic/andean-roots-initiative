---
import { cn } from '../../../../cn';
import UbicationIcon from '../../../../icons/UbicationIcon.astro';
import UpRightArrowIcon from '../../../../icons/UpRightArrowIcon.astro';

interface Metric {
  label: string;
  value: string;
}

interface Props {
  title: string;
  location: string;
  readMoreText: string;
  readMoreHref: string;
  imageSrc: string;
  imageAlt: string;
  description: string;
  metrics: Metric[];
  imagePosition?: 'left' | 'right';
}

const {
  title,
  location,
  readMoreText,
  readMoreHref,
  imageSrc,
  imageAlt,
  description,
  metrics,
  imagePosition = 'left',
} = Astro.props as Props;
---

<article
  class={cn(
    'program-card gap-4xl relative grid rounded-xl bg-light p-3xl',
    'dk:grid-cols-2 dk:items-stretch',
  )}
  data-anim="program-card"
>
  <div
    class={cn(
      'h-70 overflow-hidden rounded-lg dk:h-auto dk:min-h-98.5',
      imagePosition === 'right' && 'dk:order-2',
    )}
  >
    <img src={imageSrc} alt={imageAlt} class="size-full object-cover" loading="lazy" />
  </div>

  <div class={cn('flex min-w-0 flex-col gap-4', imagePosition === 'right' && 'dk:order-1')}>
    <div class="flex flex-col justify-center dk:h-24.5">
      <div class="gap-sm flex flex-col">
        <div class="gap-lg flex items-center">
          <UbicationIcon class="size-6 text-black" />
          <p class="body-md-l text-black">{location}</p>
        </div>

        <div class="flex items-center gap-2.5">
          <h3 class="heading-md-sb min-w-0 flex-1 text-black">{title}</h3>

          <a
            href={readMoreHref}
            class="body-md-sb text-main gap-sm inline-flex shrink-0 items-center transition-opacity hover:opacity-70"
          >
            {readMoreText}
            <UpRightArrowIcon class="text-main size-4" />
          </a>
        </div>
      </div>
    </div>

    <div class="dk:h-70 flex flex-1 flex-col justify-between gap-6 text-black">
      <p class="body-md-l">{description}</p>

      <div class="flex flex-col">
        {
          metrics.map((metric, index) => (
            <div
              class={cn(
                'gap-lg py-lg flex items-center justify-between',
                index < metrics.length - 1 && 'border-gray/50 border-b',
                index === metrics.length - 1 && 'pb-0',
              )}
            >
              <p class="body-md-l">{metric.label}</p>
              <p class="body-md-sb text-right">{metric.value}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</article>

<style>
  /* Darkens the pinned card as the next one covers it. Clicks pass through. */
  .program-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    background-color: rgb(0 0 0 / 0.5);
    opacity: var(--after-opacity, 0);
    pointer-events: none;
  }
</style>
