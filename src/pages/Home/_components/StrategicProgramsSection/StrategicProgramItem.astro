---
import { cn } from '../../../../cn';
import UbicationIcon from '../../../../icons/UbicationIcon.astro';
import UpRightArrowIcon from '../../../../icons/UpRightArrowIcon.astro';

interface Metric {
  label: string;
  value: string;
}

interface Props {
  title: string;
  location: string;
  readMoreText: string;
  readMoreHref: string;
  imageSrc: string;
  imageAlt: string;
  description: string;
  metrics: Metric[];
  imagePosition?: 'left' | 'right';
}

const {
  title,
  location,
  readMoreText,
  readMoreHref,
  imageSrc,
  imageAlt,
  description,
  metrics,
  imagePosition = 'left',
} = Astro.props as Props;
---

<article
  class={cn('gap-4xl grid rounded-xl bg-light p-3xl', 'dk:grid-cols-2 dk:items-stretch')}
  data-anim="program-card"
>
  <div
    class={cn(
      'h-70 overflow-hidden rounded-lg dk:h-auto dk:min-h-[24.625rem]',
      imagePosition === 'right' && 'dk:order-2',
    )}
    data-anim="program-image-wrap"
  >
    <img
      src={imageSrc}
      alt={imageAlt}
      class="size-full object-cover"
      loading="lazy"
      data-anim="program-image"
    />
  </div>

  <div
    class={cn('flex min-w-0 flex-col gap-4', imagePosition === 'right' && 'dk:order-1')}
    data-anim="program-body"
  >
    <div class="dk:h-[6.125rem] flex flex-col justify-center" data-anim="program-meta">
      <div class="gap-sm flex flex-col">
        <div class="gap-lg flex items-center" data-anim="program-location">
          <UbicationIcon class="size-6 text-black" />
          <p class="body-md-l text-black">{location}</p>
        </div>

        <div class="flex items-center gap-2.5">
          <h3 class="heading-md-sb min-w-0 flex-1 text-black">
            {title}
          </h3>

          <a
            href={readMoreHref}
            class="body-md-sb text-main gap-sm inline-flex shrink-0 items-center transition-opacity hover:opacity-70"
            data-anim="program-link"
          >
            {readMoreText}
            <UpRightArrowIcon class="text-main size-4" />
          </a>
        </div>
      </div>
    </div>

    <div class="dk:h-70 flex flex-1 flex-col justify-between gap-6 text-black">
      <p class="body-md-l" data-programs-text-words>{description}</p>

      <div class="flex flex-col" data-anim="program-metrics">
        {
          metrics.map((metric, index) => (
            <div
              class={cn(
                'gap-lg py-lg flex items-center justify-between',
                index < metrics.length - 1 && 'border-gray/50 border-b',
                index === metrics.length - 1 && 'pb-0',
              )}
              data-anim="program-metric-row"
            >
              <p class="body-md-l">{metric.label}</p>
              <p class="body-md-sb text-right">{metric.value}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</article>
