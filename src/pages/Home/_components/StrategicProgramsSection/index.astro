---
import ButtonLink from '../../../../components/ButtonLink/index.astro';
import StrategicProgramItem from './StrategicProgramItem.astro';
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations, getLocalizedPath } from '../../../../i18n/utils';
import { cn } from '../../../../cn';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const sp = t.strategicPrograms;
---

<section id="programs" class="px-2xl desktop:px-6xl desktop:py-6xl bg-white py-12">
  <div
    class={cn(
      'mx-auto w-full max-w-328 rounded-lg ',
      'bg-white tablet:bg-light',
      'py-6 tablet:py-10 px-0 tablet:px-10',
    )}
  >
    <div class="flex flex-col gap-4">
      <div
        class="gap-sm tablet:flex hidden items-center justify-center rounded-full"
        data-anim="label-desktop"
      >
        <span class="bg-main size-2 rounded-full" aria-hidden="true" data-anim="label-dot"></span>
        <p class="body-md-sb text-main">{sp.label}</p>
      </div>
      <p class="heading-md-sb text-main tablet:hidden text-center" data-anim="label-mobile">
        {
          sp.label.charAt(0).toUpperCase() +
            sp.label.slice(1).toLowerCase()
        }
      </p>

      <div
        class="desktop:flex-row desktop:items-start desktop:justify-between flex flex-col gap-6"
        data-anim="header"
      >
        <h2
          class={cn(
            'font-skrawk-serif text-[3rem] leading-[0.8] text-main tablet:text-[4.25rem]',
            'text-center tablet:text-start',
          )}
          data-anim="title"
          data-programs-text-line
        >
          {sp.heading}
        </h2>
        <ButtonLink
          href={getLocalizedPath(lang, sp.ctaSlug)}
          text={sp.ctaText}
          device="desktop"
          kind="primary"
          class="tablet:self-start desktop:self-auto self-center"
          data-anim="cta"
        />
      </div>
    </div>

    <div class="tablet:gap-0 mt-10 flex flex-col gap-4" data-anim="program-list">
      {
        sp.items.map((item) => (
          <StrategicProgramItem
            title={item.title}
            location={sp.location}
            readMoreText={sp.readMoreText}
            readMoreHref={sp.readMoreHref}
            imageSrc={item.imageSrc}
            imageAlt={item.imageAlt}
            description={item.description}
            metrics={item.metrics}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  import { initStrategicProgramsSectionAnimation } from './animation';

  const init = () => initStrategicProgramsSectionAnimation();
  document.addEventListener('DOMContentLoaded', init, { once: true });
  document.addEventListener('astro:page-load', init);
</script>
