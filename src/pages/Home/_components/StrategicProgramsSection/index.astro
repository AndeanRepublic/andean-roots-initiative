---
import ButtonLink from '../../../../components/ButtonLink/index.astro';
import Copy from '../../../../components/Copy/index.astro';
import StrategicProgramItem from './StrategicProgramItem.astro';
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations, getLocalizedPath } from '../../../../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const sp = t.strategicPrograms;
---

<section id="programs" class="px-2xl py-6xl dk:px-6xl bg-white">
  <div class="gap-6xl mx-auto flex w-full max-w-328 flex-col">
    <div class="gap-4xl dk:flex-row dk:items-end dk:justify-between flex flex-col">
      <div class="gap-4xl flex w-full max-w-190.25 flex-col">
        <div class="gap-sm flex items-center" data-anim="label-desktop">
          <span class="bg-main size-2 rounded-full" aria-hidden="true" data-anim="label-dot"></span>
          <p class="body-md-sb text-main">{sp.label}</p>
        </div>

        <Copy
          variant="slideFromBottom"
          type="words"
          reverse
          ease="power3.out"
          duration={0.9}
          delay={0}
          stagger={0.2}
          animateOnScroll={true}
          start="top 80%"
          class="w-full"
        >
          <h2 class="text-main flex w-full flex-col items-end">
            <span class="section-heading w-full uppercase">{sp.headingTop}</span>
            <span class="heading-eyebrow w-full text-right">{sp.headingBottom}</span>
          </h2>
        </Copy>
      </div>

      <ButtonLink
        href={getLocalizedPath(lang, sp.ctaSlug)}
        text={sp.ctaText}
        device="desktop"
        kind="primary"
        class="dk:self-auto self-start **:data-button-link:gap-4 **:data-button-link:py-2 **:data-button-link:pr-2 **:data-button-link:pl-6 [&_[data-button-link]>span:first-child]:text-base [&_[data-button-link]>span:last-child]:p-2 [&_[data-button-link]>span:last-child>svg]:size-5"
        data-anim="cta"
      />
    </div>

    <div class="gap-4xl flex flex-col" data-anim="program-list">
      {
        sp.items.map((item, index) => (
          <StrategicProgramItem
            title={item.title}
            location={sp.location}
            readMoreText={sp.readMoreText}
            readMoreHref={sp.readMoreHref}
            imageSrc={item.imageSrc}
            imageAlt={item.imageAlt}
            description={item.description}
            metrics={item.metrics}
            imagePosition={index % 2 === 0 ? 'left' : 'right'}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  import { initStrategicProgramsSectionAnimation } from './animation';

  const init = () => initStrategicProgramsSectionAnimation();

  document.addEventListener('astro:page-load', init);
</script>
