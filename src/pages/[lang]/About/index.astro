---
import type { Locale } from '../../../i18n/locales';
import { LOCALES } from '../../../i18n/locales';
import { useTranslations } from '../../../i18n/utils';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import HeroSection from '../../About/_components/HeroSection/index.astro';
import HistorySection from '../../About/_components/HistorySection/index.astro';
import OrganizationSection from '../../About/_components/OrganizationSection/index.astro';
import ValuesSection from '../../About/_components/ValuesSection/index.astro';
import FocusSection from '../../About/_components/FocusSection/index.astro';
import TeamSection from '../../About/_components/TeamSection/index.astro';
import CTA from '../../../components/CTA.astro';
import Footer from '../../../components/Footer.astro';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
---

<Layout lang={lang} title={lang === 'en' ? 'About | Andean Roots Initiative' : 'Sobre nosotros | Andean Roots Initiative'}>
  <Header lang={lang} />
  <HeroSection lang={lang} />
  <HistorySection lang={lang} />
  <OrganizationSection lang={lang} />
  <ValuesSection lang={lang} />
  <FocusSection lang={lang} />
  <TeamSection lang={lang} />
  <CTA lang={lang} />
  <Footer lang={lang} />
</Layout>
