---
import type { Locale } from '../../../i18n/locales';
import { LOCALES } from '../../../i18n/locales';
import { useTranslations } from '../../../i18n/utils';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header/index.astro';
import HeroSection from '../../Home/_components/HeroSection/index.astro';
import ChallengeSection from '../../Home/_components/ChallengeSection/index.astro';
import AboutSection from '../../Home/_components/AboutSection/index.astro';
import ActionSection from '../../Home/_components/ActionSection/index.astro';
import NumbersSection from '../../Home/_components/NumbersSection/index.astro';
import StrategicProgramsSection from '../../Home/_components/StrategicProgramsSection/index.astro';
import PartnershipSection from '../../Home/_components/PartnershipSection/index.astro';
import CTA from '../../../components/CTA/index.astro';
import Footer from '../../../components/Footer/index.astro';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
---

<Layout lang={lang}>
  <Header lang={lang} heroEntrance />
  <HeroSection lang={lang} />
  <ChallengeSection lang={lang} />
  <AboutSection lang={lang} />
  <ActionSection lang={lang} />
  <NumbersSection lang={lang} />
  <StrategicProgramsSection lang={lang} />
  <PartnershipSection lang={lang} />
  <CTA lang={lang} />
  <Footer lang={lang} />
</Layout>

<script>
  const resetHomeScrollToTop = () => {
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }
    window.scrollTo({ top: 0, left: 0, behavior: 'auto' });
  };

  document.addEventListener('astro:page-load', resetHomeScrollToTop);
</script>
