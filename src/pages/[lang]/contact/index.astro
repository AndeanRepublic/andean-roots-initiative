---
import type { Locale } from '../../../i18n/locales';
import { DEFAULT_LOCALE, LOCALES } from '../../../i18n/locales';
import { useTranslations } from '../../../i18n/utils';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header/index.astro';
import ContactHeroSection from '../../contact/_components/ContactHeroSection/index.astro';
import ContactImpactSection from '../../contact/_components/ContactImpactSection/index.astro';
import ContactFormSection from '../../contact/_components/ContactFormSection/index.astro';
import Footer from '../../../components/Footer/index.astro';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
if (lang === DEFAULT_LOCALE) {
  return Astro.redirect('/contact', 301);
}
---

<Layout lang={lang} title={t.contactPage.meta.title} description={t.contactPage.meta.description}>
  <Header lang={lang} />
  <ContactHeroSection lang={lang} />
  <ContactImpactSection lang={lang} />
  <ContactFormSection lang={lang} />
  <Footer lang={lang} />
</Layout>
