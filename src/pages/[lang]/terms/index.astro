---
import type { Locale } from '../../../i18n/locales';
import { DEFAULT_LOCALE, LOCALES } from '../../../i18n/locales';
import { useTranslations } from '../../../i18n/utils';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import TermsHeroSection from '../../terms/_components/TermsHeroSection/index.astro';
import TermsContent from '../../terms/_components/TermsContent/index.astro';
import Footer from '../../../components/Footer.astro';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
if (lang === DEFAULT_LOCALE) {
  return Astro.redirect('/terms', 301);
}
---

<Layout lang={lang} title={t.termsPage.meta.title} description={t.termsPage.meta.description}>
  <Header lang={lang} />
  <TermsHeroSection lang={lang} />
  <TermsContent lang={lang} />
  <Footer lang={lang} />
</Layout>
