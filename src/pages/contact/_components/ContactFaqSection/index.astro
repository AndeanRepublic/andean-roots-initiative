---
import { cn } from '../../../../cn';
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations, getLocalizedPath } from '../../../../i18n/utils';
import ButtonLink from '../../../../components/ButtonLink/index.astro';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const faq = t.contactPage.faq;
---

<section
  id="contact-faq"
  class="px-2xl dk:py-6xl bg-white py-12"
  aria-labelledby="contact-faq-heading"
>
  <div class="dk:gap-12 dk:grid-cols-[3fr_4fr] mx-auto grid w-full max-w-328 gap-10">
    <div class="flex min-w-0 flex-col gap-8">
      <div class="flex max-w-160 flex-col gap-3" data-anim="faq-intro">
        <h2
          id="contact-faq-heading"
          class={cn(
            'text-[1.875rem] tb:text-[2.5rem] dk:text-[3rem]',
            'font-nunito-sans font-semibold leading-[120%] tracking-normal',
            'text-main',
          )}
        >
          {faq.title}
        </h2>
        <p class="body-md-l text-gray">
          {faq.subtitle}
        </p>
      </div>
      <div class="bg-light overflow-hidden rounded-2xl shadow-xs" data-anim="faq-visual">
        <img
          src={faq.sideImageSrc}
          alt={faq.sideImageAlt}
          class="h-[300px] w-full rounded-xl object-cover"
          loading="lazy"
        />
      </div>
      <div data-anim="faq-cta">
        <ButtonLink
          href={getLocalizedPath(lang, 'contact')}
          text={faq.ctaText}
          device="desktop"
          kind="primary"
          class="w-fit"
        />
      </div>
    </div>

    <div class="dk:sticky dk:top-32 h-min">
      <div class="flex flex-col gap-4">
        {
          faq.items.map((item) => (
            <details
              class="group hover:border-main/30 bg-light rounded-xl border border-black/5 p-6 transition-colors open:bg-white open:shadow-sm"
              data-anim="faq-item"
            >
              <summary class="body-lg-sb flex cursor-pointer list-none items-center justify-between gap-4 text-black [&::-webkit-details-marker]:hidden">
                <span>{item.q}</span>
                <span
                  class="text-main inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-white text-lg leading-none ring-1 ring-black/5 transition-transform group-open:rotate-45"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <p class="body-md-l text-gray mt-4">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { initContactFaqSectionAnimation } from './animation';

  const init = () => initContactFaqSectionAnimation();

  document.addEventListener('astro:page-load', init);
</script>
