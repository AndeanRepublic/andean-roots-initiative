---
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const { common } = useTranslations(lang);
---

<div class="flex items-center gap-3">
  {
    common.socialLinks.map((link) => (
      <a
        href={link.href}
        aria-label={link.ariaLabel}
        class="hover:bg-main inline-flex size-8 items-center justify-center rounded-full border border-white/25 text-white/80 transition-colors hover:text-white"
        target="_blank"
        rel="noopener noreferrer"
      >
        {link.platform === 'twitter' && (
          <svg viewBox="0 0 24 24" class="size-4 fill-current" aria-hidden="true">
            <path d="M18.901 2H22.581L14.541 11.193L24 22H16.595L10.792 15.442L5.003 22H1.319L9.919 12.257L0.845 2H8.438L13.684 8.011L18.901 2ZM17.607 19.806H19.646L7.33 4.079H5.143L17.607 19.806Z" />
          </svg>
        )}
        {link.platform === 'facebook' && (
          <svg viewBox="0 0 24 24" class="size-4 fill-current" aria-hidden="true">
            <path d="M13.5 22V12.875H16.56L17 9.32H13.5V7.057C13.5 6.028 13.773 5.325 15.183 5.325H17.1V2.14C16.767 2.093 15.62 2 14.286 2C11.5 2 9.6 3.754 9.6 6.974V9.313H6.5V12.867H9.6V22H13.5Z" />
          </svg>
        )}
        {link.platform === 'instagram' && (
          <svg viewBox="0 0 24 24" class="size-4 fill-current" aria-hidden="true">
            <path d="M12 7.838A4.162 4.162 0 1 0 12 16.162A4.162 4.162 0 1 0 12 7.838ZM12 14.702A2.702 2.702 0 1 1 12 9.298A2.702 2.702 0 0 1 12 14.702ZM17.303 7.674A.972.972 0 1 0 17.303 5.73A.972.972 0 1 0 17.303 7.674ZM20.064 7.689C20.002 6.382 19.703 5.222 18.744 4.265C17.787 3.308 16.627 3.009 15.32 2.946C13.973 2.869 10.027 2.869 8.68 2.946C7.375 3.009 6.215 3.308 5.256 4.265C4.297 5.222 3.999 6.382 3.936 7.689C3.859 9.036 3.859 12.982 3.936 14.329C3.999 15.634 4.297 16.794 5.256 17.753C6.215 18.71 7.373 19.009 8.68 19.072C10.027 19.149 13.973 19.149 15.32 19.072C16.627 19.009 17.787 18.71 18.744 17.753C19.703 16.794 20.002 15.636 20.064 14.329C20.141 12.982 20.141 9.036 20.064 7.689ZM18.328 15.866C18.043 16.582 17.493 17.133 16.777 17.417C15.704 17.842 13.158 17.744 12 17.744C10.842 17.744 8.294 17.842 7.223 17.417C6.507 17.133 5.957 16.582 5.672 15.866C5.247 14.795 5.345 12.248 5.345 11.09C5.345 9.932 5.247 7.386 5.672 6.313C5.957 5.598 6.507 5.047 7.223 4.762C8.294 4.337 10.842 4.435 12 4.435C13.158 4.435 15.704 4.337 16.777 4.762C17.493 5.047 18.043 5.598 18.328 6.313C18.753 7.386 18.655 9.932 18.655 11.09C18.655 12.248 18.753 14.795 18.328 15.866Z" />
          </svg>
        )}
        {link.platform === 'linkedin' && (
          <svg viewBox="0 0 24 24" class="size-4 fill-current" aria-hidden="true">
            <path d="M6.2 8.2C7.526 8.2 8.6 7.126 8.6 5.8C8.6 4.474 7.526 3.4 6.2 3.4C4.874 3.4 3.8 4.474 3.8 5.8C3.8 7.126 4.874 8.2 6.2 8.2ZM4.1 20.6H8.2V9.6H4.1V20.6ZM10.6 20.6H14.7V14.9C14.7 13.398 14.983 11.943 16.844 11.943C18.678 11.943 18.7 13.658 18.7 14.996V20.6H22.8V14.19C22.8 11.042 22.122 8.622 18.442 8.622C16.676 8.622 15.494 9.591 15.01 10.509H14.96V9.6H10.6V20.6Z" />
          </svg>
        )}
        <span class="sr-only">{link.ariaLabel}</span>
      </a>
    ))
  }
</div>
