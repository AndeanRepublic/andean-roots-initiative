---
import Copy from '../../../../components/Copy/index.astro';
import MailIcon from '../../../../icons/MailIcon.astro';
import PhoneIcon from '../../../../icons/PhoneIcon.astro';
import UpRightArrowIcon from '../../../../icons/UpRightArrowIcon.astro';
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const cf = t.contactPage.form;
---

<section id={cf.sectionId} class="px-2xl dk:py-6xl bg-white py-12">
  <div class="dk:flex-row dk:items-stretch dk:justify-center dk:gap-6 mx-auto flex w-full max-w-328 flex-col gap-6">
    <div class="bg-light dk:max-w-132.5 dk:h-full flex w-full flex-col gap-8 rounded-20px p-6">
      <Copy
        variant="slideFromBottom"
        type="words"
        reverse
        ease="power3.out"
        duration={0.9}
        delay={0}
        stagger={0.2}
        animateOnScroll={true}
        start="top 80%"
        class="w-full"
      >
        <h2 class="heading-md-sb text-black">{cf.title}</h2>
      </Copy>

      <form class="dk:flex-1 flex flex-col justify-between gap-8" data-contact-form novalidate>
        <div aria-live="polite" class="body-sm-l text-gray empty:hidden" data-contact-form-status>
        </div>

        <div class="flex flex-col gap-4">
          <label class="flex flex-col gap-3">
            <span class="body-md-sb text-black">{cf.fullNameLabel}</span>
            <input
              name="name"
              type="text"
              autocomplete="name"
              required
              placeholder={cf.fullNamePlaceholder}
              class="body-md-l text-black placeholder:text-gray rounded-sm bg-white p-2.5 outline-none"
            />
          </label>

          <label class="flex flex-col gap-3">
            <span class="body-md-sb text-black">{cf.emailLabel}</span>
            <input
              name="email"
              type="email"
              autocomplete="email"
              required
              placeholder={cf.emailPlaceholder}
              class="body-md-l text-black placeholder:text-gray rounded-sm bg-white p-2.5 outline-none"
            />
          </label>

          <label class="flex flex-col gap-3">
            <span class="body-md-sb text-black">{cf.phoneLabel}</span>
            <input
              name="phone"
              type="tel"
              autocomplete="tel"
              placeholder={cf.phonePlaceholder}
              class="body-md-l text-black placeholder:text-gray rounded-sm bg-white p-2.5 outline-none"
            />
          </label>

          <label class="flex flex-col gap-3">
            <span class="body-md-sb text-black">{cf.messageLabel}</span>
            <textarea
              name="message"
              required
              placeholder={cf.messagePlaceholder}
              class="body-md-l text-black placeholder:text-gray min-h-32.25 resize-none rounded-sm bg-white p-2.5 outline-none"
            ></textarea>
          </label>
        </div>

        <input type="hidden" name="topic" value="general" />

        <div class="sr-only" aria-hidden="true">
          <label for="contact-company">Company</label>
          <input id="contact-company" name="_honey" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <button
          type="submit"
          data-contact-form-submit
          class="bg-main gap-4 rounded-full py-2 pr-2 pl-6 text-white inline-flex w-full cursor-pointer items-center justify-end disabled:cursor-not-allowed disabled:opacity-40"
        >
          <span class="body-md-sb text-white" data-contact-form-submit-label>{cf.submitLabel}</span>
          <span class="flex items-center justify-center rounded-full bg-white p-2">
            <UpRightArrowIcon class="size-5 text-main" />
          </span>
        </button>
      </form>
    </div>

    <div class="dk:max-w-132.5 flex w-full flex-col gap-6">
      <div class="dk:h-126 h-70 overflow-hidden rounded-20px">
        <img
          src={cf.imageSrc}
          alt={cf.imageAlt}
          class="size-full object-cover"
          loading="lazy"
        />
      </div>

      <div class="bg-light flex flex-col gap-4 rounded-20px p-6">
        <a href={cf.phoneHref} class="gap-4 inline-flex items-end">
          <PhoneIcon class="size-9 text-black" />
          <span class="font-manrope text-[1.25rem] leading-normal font-light text-black">
            {cf.phone}
          </span>
        </a>
        <a href={cf.emailHref} class="gap-4 inline-flex items-start">
          <MailIcon class="size-9 text-black" />
          <span class="font-manrope text-[1.25rem] leading-normal font-light text-black">
            {cf.email}
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<div
  id="contact-form-strings"
  hidden
  data-submit-label={cf.submitLabel}
  data-sending-label={cf.sendingLabel}
  data-success-message={cf.successMessage}
  data-error-message={cf.errorMessage}
>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const statusEl = document.querySelector<HTMLElement>('[data-contact-form-status]');
  const submitBtn = document.querySelector<HTMLButtonElement>('[data-contact-form-submit]');
  const submitLabelEl = document.querySelector<HTMLElement>('[data-contact-form-submit-label]');
  const stringsEl = document.getElementById('contact-form-strings');

  const strings = {
    submitLabel: stringsEl?.dataset.submitLabel ?? 'Send',
    sendingLabel: stringsEl?.dataset.sendingLabel ?? 'Sending…',
    successMessage: stringsEl?.dataset.successMessage ?? 'Message sent.',
    errorMessage: stringsEl?.dataset.errorMessage ?? 'Error sending message.',
  };

  const showToast = (message: string) => {
    const existing = document.getElementById('contact-toast');
    if (existing) existing.remove();

    const toast = document.createElement('div');
    toast.id = 'contact-toast';
    toast.setAttribute('role', 'status');
    toast.setAttribute('aria-live', 'polite');
    toast.textContent = message;
    toast.style.cssText = `
      position: fixed;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%) translateY(1rem);
      background: #1a1a1a;
      color: #fff;
      padding: 1rem 1.5rem;
      border-radius: 0.5rem;
      font-size: 0.9rem;
      max-width: calc(100vw - 2rem);
      text-align: center;
      box-shadow: 0 8px 24px rgba(0,0,0,0.3);
      opacity: 0;
      transition: opacity 0.3s ease, transform 0.3s ease;
      z-index: 9999;
    `;
    document.body.appendChild(toast);

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        toast.style.opacity = '1';
        toast.style.transform = 'translateX(-50%) translateY(0)';
      });
    });

    setTimeout(() => {
      toast.style.opacity = '0';
      toast.style.transform = 'translateX(-50%) translateY(1rem)';
      toast.addEventListener('transitionend', () => toast.remove(), { once: true });
    }, 5000);
  };

  if (form && statusEl && submitBtn && submitLabelEl) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.reportValidity()) return;

      submitBtn.disabled = true;
      submitLabelEl.textContent = strings.sendingLabel;
      statusEl.textContent = '';

      const formData = new FormData(form);
      const payload: Record<string, string> = {};
      formData.forEach((value, key) => {
        payload[key] = String(value);
      });

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (!response.ok) {
          throw new Error(`Contact API error: ${response.status}`);
        }

        showToast(strings.successMessage);
        form.reset();
      } catch {
        statusEl.textContent = strings.errorMessage;
      } finally {
        submitBtn.disabled = false;
        submitLabelEl.textContent = strings.submitLabel;
      }
    });
  }
</script>
