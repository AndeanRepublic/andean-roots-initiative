---
import { cn } from '../../../../cn';
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const ci = t.contactPage.impact;
---

<section
  id="contact-impact"
  class="px-2xl dk:py-6xl bg-white py-12"
  aria-labelledby="contact-impact-heading"
>
  <div class="mx-auto w-full max-w-328">
    <div class="tb:px-8 dk:px-14 dk:py-14 relative overflow-hidden px-6 py-10">
      <div class="dk:gap-12 relative z-1 flex flex-col items-center gap-8 text-center">
        <h2
          id="contact-impact-heading"
          data-anim="headline"
          class={cn(
            'text-[1.875rem] tb:text-[2.625rem] dk:text-[5rem]',
            'font-bebas-neue font-[500] leading-[105%] tracking-[0.02em]',
            'tb:max-w-none max-w-220 text-black uppercase',
          )}
        >
          {ci.headlineBefore}
          <span class="relative isolate inline-block align-baseline">
            <span class="relative z-10">{ci.headlineHighlight}</span>
            <span
              class="bg-main dk:h-6 dk:bottom-2 pointer-events-none absolute inset-x-0 bottom-1 z-0 h-3"
              aria-hidden="true"></span>
          </span>.
        </h2>

        <div class="text-gray flex max-w-200 flex-col gap-4">
          {
            ci.paragraphs.map((p) => (
              <p class="body-md-l" data-anim="impact-p">
                {p}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initContactImpactSectionAnimation } from './animation';

  const init = () => initContactImpactSectionAnimation();

  document.addEventListener('astro:page-load', init);
</script>
