---
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const q = t.contactPage.quote;
---

<section
  id="contact-quote"
  class="px-2xl dk:py-6xl bg-light py-12"
  aria-labelledby="contact-quote-text"
>
  <div class="mx-auto w-full max-w-328">
    <div
      class="tb:px-8 dk:px-12 relative overflow-hidden rounded-2xl border border-black/5 bg-white px-6 py-12 text-center"
    >
      <div
        class="bg-main/10 absolute -top-14 right-12 size-40 rounded-full blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="bg-main/10 absolute -bottom-20 left-12 size-56 rounded-full blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div class="relative z-1 mx-auto flex w-full max-w-200 flex-col items-center gap-8">
        <p
          class="text-main font-nunito-sans text-[4rem] leading-none font-semibold opacity-90"
          aria-hidden="true"
          data-anim="quote-mark"
        >
          &ldquo;
        </p>

        <blockquote class="flex flex-col gap-8">
          <p
            id="contact-quote-text"
            class="heading-md-sb tb:max-w-none max-w-160 text-pretty text-black italic"
            data-anim="quote-text"
          >
            {q.quote}
          </p>

          <footer class="flex flex-col items-center gap-3" data-anim="quote-footer">
            <img
              src={q.portraitSrc}
              alt={q.portraitAlt}
              class="ring-main/30 size-16 rounded-full object-cover ring-2"
              width="64"
              height="64"
              loading="lazy"
            />
            <div class="flex flex-col gap-1">
              <cite class="heading-xs-sb text-main not-italic">
                {q.attributionName}
              </cite>
              <span class="body-sm-l text-gray">{q.attributionRole}</span>
            </div>
          </footer>
        </blockquote>
      </div>
    </div>
  </div>
</section>

<script>
  import { initContactQuoteSectionAnimation } from './animation';

  const init = () => initContactQuoteSectionAnimation();

  document.addEventListener('astro:page-load', init);
</script>
