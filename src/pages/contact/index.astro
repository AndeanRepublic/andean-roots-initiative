---
import { DEFAULT_LOCALE } from '../../i18n/locales';
import { useTranslations } from '../../i18n/utils';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header/index.astro';
import ContactHeroSection from './_components/ContactHeroSection/index.astro';
import ContactImpactSection from './_components/ContactImpactSection/index.astro';
import ContactFormSection from './_components/ContactFormSection/index.astro';
import Footer from '../../components/Footer/index.astro';

const lang = DEFAULT_LOCALE;
const t = useTranslations(lang);
---

<Layout lang={lang} title={t.contactPage.meta.title} description={t.contactPage.meta.description}>
  <Header lang={lang} />
  <ContactHeroSection lang={lang} />
  <ContactImpactSection lang={lang} />
  <ContactFormSection lang={lang} />
  <Footer lang={lang} />
</Layout>
