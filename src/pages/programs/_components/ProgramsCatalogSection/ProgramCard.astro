---
import UbicationIcon from '../../../../icons/UbicationIcon.astro';

interface Props {
  title: string;
  imageSrc: string;
  imageAlt: string;
  description: string;
  href: string;
  location: string;
  statusLabel: string;
  ctaText: string;
}

const { title, imageSrc, imageAlt, description, href, location, statusLabel, ctaText } =
  Astro.props as Props;
---

<article class="bg-light p-md flex h-full flex-col gap-4 rounded-xl" data-anim="program-card">
  <div class="overflow-hidden rounded-lg" data-anim="program-image-wrap">
    <img
      src={imageSrc}
      alt={imageAlt}
      class="tablet:h-64 desktop:h-82 h-56 w-full object-cover"
      loading="lazy"
      data-anim="program-image"
    />
  </div>

  <div class="flex min-h-0 flex-1 flex-col justify-between gap-6">
    <div class="flex flex-col gap-3">
      <h3 class="heading-sm-sb text-black" data-anim="program-title">{title}</h3>
      <p class="body-md-l text-gray" data-programs-card-text-words>{description}</p>
    </div>

    <div class="flex flex-col gap-4">
      <div class="gap-lg flex items-center text-black">
        <div class="flex items-center gap-3">
          <UbicationIcon class="size-6 text-black" />
          <p class="body-md-l">{location}</p>
        </div>
        <span class="bg-gray/30 h-4 w-px" aria-hidden="true"></span>
        <div class="flex items-center gap-2">
          <span class="size-2.5 rounded-full bg-[#00c950]" aria-hidden="true"></span>
          <p class="body-md-l">{statusLabel}</p>
        </div>
      </div>

      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        class="body-md-sb bg-main px-xl py-md rounded-full text-center text-white transition-opacity hover:opacity-90"
      >
        {ctaText}
      </a>
    </div>
  </div>
</article>
