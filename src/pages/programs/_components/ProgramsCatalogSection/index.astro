---
import { cn } from '../../../../cn';
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';
import ProgramCard from './ProgramCard.astro';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const pc = t.programsPage.catalog;
const { common } = t;
---

<section
  id={pc.sectionId}
  class="px-2xl desktop:py-6xl flex flex-col items-center gap-12 bg-white py-12"
>
  <div
    class={cn(
      'tablet:grid-cols-2 desktop:grid-cols-2 desktop:gap-8 mx-auto grid w-full max-w-328 gap-6',
      'tablet:[&>article:last-child:nth-child(odd)]:col-span-2',
      'tablet:[&>article:last-child:nth-child(odd)]:w-full',
      'tablet:[&>article:last-child:nth-child(odd)]:max-w-[calc((100%-1.5rem)/2)]',
      'tablet:[&>article:last-child:nth-child(odd)]:justify-self-center',
      'desktop:[&>article:last-child:nth-child(odd)]:max-w-[calc((100%-2rem)/2)]',
    )}
  >
    {
      pc.items.map((item) => (
        <ProgramCard
          title={item.title}
          imageSrc={item.imageSrc}
          imageAlt={item.imageAlt}
          description={item.description}
          href={common.whatsappHref}
          location={pc.location}
          statusLabel={pc.statusLabel}
          ctaText={pc.ctaText}
        />
      ))
    }
  </div>
</section>

<script>
  import { initProgramsCatalogSectionAnimation } from './animation';

  const init = () => initProgramsCatalogSectionAnimation();
  document.addEventListener('DOMContentLoaded', init, { once: true });
  document.addEventListener('astro:page-load', init);
</script>
