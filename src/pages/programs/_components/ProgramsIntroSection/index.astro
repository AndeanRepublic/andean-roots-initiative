---
import { cn } from '../../../../cn';
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const pi = t.programsPage.intro;
---

<section
  id="programs-intro"
  class="px-2xl desktop:py-6xl bg-white py-12"
  aria-labelledby="programs-intro-heading"
>
  <div class="mx-auto flex w-full max-w-320 flex-col gap-20">
    <div class="mx-auto flex w-full max-w-310 flex-col items-center gap-20 text-center">
      <h2
        id="programs-intro-heading"
        class="text-main flex flex-col items-center gap-2"
        data-anim="title-wrap"
      >
        <span class="flex flex-wrap items-end justify-center gap-2" data-anim="title-line">
          <span
            class={cn(
              'text-[3rem] tablet:text-[3rem] desktop:text-[5rem]',
              'font-skrawk-serif font-normal leading-[0.8] tracking-normal text-inherit',
            )}
            data-programs-intro-text-line
          >
            {pi.titleLeading}
          </span>
          <span
            class={cn(
              'text-[1.5rem] tablet:text-[1.5rem] desktop:text-[2rem]',
              'font-nunito-sans font-semibold leading-none tracking-normal text-inherit',
              'pt-1',
            )}
            data-programs-intro-text-line
          >
            {pi.titleMiddle}
          </span>
        </span>
        <span class="flex flex-wrap items-end justify-center gap-2" data-anim="title-line">
          <span
            class={cn(
              'text-[1.5rem] tablet:text-[1.5rem] desktop:text-[2rem]',
              'font-nunito-sans font-semibold leading-none tracking-normal text-inherit',
              'pt-1',
            )}
            data-programs-intro-text-line
          >
            {pi.titleTrailingStart}
          </span>
          <span
            class={cn(
              'text-[3rem] tablet:text-[3rem] desktop:text-[5rem]',
              'font-skrawk-serif font-normal leading-[0.8] tracking-normal text-inherit',
            )}
            data-programs-intro-text-line
          >
            &nbsp;{pi.titleTrailingEmphasis}
          </span>
        </span>
      </h2>

      <p
        class={cn(
          'desktop:text-[2rem] desktop:leading-[1.4]',
          'tablet:text-[1.5rem] tablet:leading-[1.4]',
          'text-[1.125rem] leading-[1.5] text-black',
          'font-manrope font-medium',
        )}
        data-anim="description"
      >
        {pi.descriptionLead}
        <span class="text-gray">{pi.descriptionMutedA}</span>
        {pi.descriptionMiddle}
        <span class="text-gray">{pi.descriptionMutedB}</span>
      </p>
    </div>

    <div
      class="tablet:gap-10 desktop:gap-16 mx-auto flex w-full max-w-190 items-stretch justify-center gap-6"
    >
      {
        pi.stats.map((item, index) => (
          <>
            {index > 0 && (
              <div class="bg-gray/30 tablet:block mt-2 hidden w-px shrink-0" aria-hidden="true" />
            )}
            <article
              class="flex min-w-0 flex-1 flex-col items-center gap-2 text-center"
              data-anim="stat-item"
            >
              <p class="heading-lg-sb text-black" data-anim="stat-value">
                {item.value}
              </p>
              <p class="body-md-l text-black" data-anim="stat-label">
                {item.label}
              </p>
            </article>
          </>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { initProgramsIntroSectionAnimation } from './animation';

  const init = () => initProgramsIntroSectionAnimation();
  document.addEventListener('DOMContentLoaded', init, { once: true });
  document.addEventListener('astro:page-load', init);
</script>
