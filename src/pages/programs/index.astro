---
import { DEFAULT_LOCALE } from '../../i18n/locales';
import { useTranslations } from '../../i18n/utils';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header/index.astro';
import ProgramsHeroSection from './_components/ProgramsHeroSection/index.astro';
import ProgramsIntroSection from './_components/ProgramsIntroSection/index.astro';
import ProgramsCatalogSection from './_components/ProgramsCatalogSection/index.astro';
import ProgramsCtaSection from './_components/ProgramsCtaSection/index.astro';
import Footer from '../../components/Footer/index.astro';

const lang = DEFAULT_LOCALE;
const t = useTranslations(lang);
---

<Layout lang={lang} title={t.programsPage.meta.title} description={t.programsPage.meta.description}>
  <Header lang={lang} />
  <ProgramsHeroSection lang={lang} />
  <ProgramsIntroSection lang={lang} />
  <ProgramsCatalogSection lang={lang} />
  <ProgramsCtaSection lang={lang} />
  <Footer lang={lang} />
</Layout>
